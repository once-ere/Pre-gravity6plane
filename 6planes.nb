Cell["\<\
8.2 The primordial field: a degenerate but singular 'bridge' at x0 = 0\
\>", "Subsection",ExpressionUUID->"1efdbd98-3fbe-4913-b612-c041c012eb0c"],

Cell["\<\
In the primordial field g_00 = Tan[6 H x0]^2 vanishes at x0 = 0 and the \
metric is even in x0 if Sin is replaced by |Sin|: formally two sheets x0 > 0 \
and x0 < 0 joined where g_00 = 0. But the Ricci scalar diverges there, so \
this is NOT a regular Einstein-Rosen bridge.\
\>", "Text",ExpressionUUID->"1117bbb3-ea46-4f9d-9f1b-4eaf816e23e9"],

Cell["\<\
gP = DiagonalMatrix[fields[\"primordial\"]^2 {1, 1, 1, 1, -1, -1, -1, -1}];
RscalarP = Simplify[Tr[Inverse[gP].ricciG[gP, X]], 0 < 6 H x0 < Pi/2];
<|\"Ricci scalar of primordial field\" -> RscalarP, \"series as x0 -> 0\" -> \
Series[RscalarP, {x0, 0, -3}], \"det g\" -> Simplify[Det[gP], 0 < 6 H x0 < \
Pi/2]|>\
\>", "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"2c7229d8-a9a6-401c-9aa3-4a73627f939e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Ricci scalar of primordial field\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["3", "2"]}], " ", 
     SuperscriptBox["H", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"57", "+", 
       RowBox[{"64", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"12", " ", "H", " ", "x0"}], "]"}]}], "+", 
       RowBox[{"3", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"24", " ", "H", " ", "x0"}], "]"}]}]}], ")"}], " ", 
     SuperscriptBox[
      RowBox[{"Csc", "[", 
       RowBox[{"6", " ", "H", " ", "x0"}], "]"}], "4"]}]}], ",", 
   RowBox[{"\<\"series as x0 -> 0\"\>", "\[Rule]", 
    InterpretationBox[
     RowBox[{
      RowBox[{"-", 
       FractionBox["31", 
        RowBox[{"216", " ", 
         SuperscriptBox["H", "2"], " ", 
         SuperscriptBox["x0", "4"]}]]}], "+", 
      InterpretationBox[
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"O", "[", "x0", "]"}], "2"]],
       SeriesData[$CellContext`x0, 0, {}, -4, -2, 1],
       Editable->False]}],
     SeriesData[$CellContext`x0, 0, {
      Rational[-31, 216] $CellContext`H^(-2)}, -4, -2, 1],
     Editable->False]}], ",", 
   RowBox[{"\<\"det g\"\>", "\[Rule]", 
    SuperscriptBox[
     RowBox[{"Sec", "[", 
      RowBox[{"6", " ", "H", " ", "x0"}], "]"}], "2"]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[33]=",ExpressionUUID->"dcb728bc-0a26-4281-afee-9bc3d845ad7a"],

Cell["\<\
8.3 Pairs of universes across a bridge (Unruh-Israel-Hartle-Hawking)\
\>", "Subsection",ExpressionUUID->"5611ea43-3fe0-4798-973d-77385ef4cdca"],

Cell["\<\
Near a non-degenerate horizon introduce Kruskal coordinates U = -Exp[-kappa \
(x4 - rho)], V = Exp[kappa (x4 + rho)] on sheet I; on the second sheet U > 0. \
A mode of Killing frequency eps on sheet I behaves as (-U)^(I eps/kappa). The \
combination that is analytic in the lower half U-plane, (U - I 0)^(I \
eps/kappa), continues to the second sheet with the factor Exp[-Pi eps/kappa] \
(computed below): the Kruskal (Hartle-Hawking) vacuum is a superposition of \
PAIRS, a universe of Killing energy +eps on one sheet and its partner of \
Killing energy -eps on the other, with fermion occupation 1/(Exp[2 Pi \
eps/kappa] + 1), i.e. a Kohn-Sham fermion gas at the Hawking temperature T_H \
= kappa/(2 Pi) (Part 6.4).\
\>", "Text",ExpressionUUID->"38af91b4-dc38-4e16-92e2-884fcca5d729"],

Cell["\<\
analyticFactor = Simplify[(Exp[-I Pi] Uk)^(I eps/kappa)/Uk^(I eps/kappa), {Uk \
> 0, eps > 0, kappa > 0}];
occupation = Simplify[Abs[analyticFactor]^2/(1 + Abs[analyticFactor]^2), {eps \
> 0, kappa > 0}];
<|\"continuation factor to the second sheet\" -> analyticFactor, \"occupation \
number |beta|^2\" -> occupation,
 \"Fermi-Dirac at T_H = kappa/(2 Pi)\" -> Simplify[occupation - \
1/(Exp[eps/(kappa/(2 Pi))] + 1)] == 0|>\
\>", "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"0945a645-eca6-4069-957d-eebe084efaf1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"continuation factor to the second sheet\"\>", "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"eps", " ", "\[Pi]"}], "kappa"]}]]}], ",", 
   RowBox[{"\<\"occupation number |beta|^2\"\>", "\[Rule]", 
    FractionBox["1", 
     RowBox[{"1", "+", 
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"2", " ", "eps", " ", "\[Pi]"}], "kappa"]]}]]}], ",", 
   RowBox[{"\<\"Fermi-Dirac at T_H = kappa/(2 Pi)\"\>", "\[Rule]", "True"}]}],
   "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[34]=",ExpressionUUID->"3333fd56-de08-4ddf-8d48-6ccaf595c5a0"],

Cell["\<\
Summary of Part 8: the Einstein-Rosen bridges of 1935 are exact (verified); \
the modern and future fields contain exact Einstein-Rosen bridges at their \
horizons (regular, two congruent sheets, g vanishing on the bridge); the \
primordial field has a degenerate hypersurface at x0 = 0 that is a curvature \
singularity; across every regular bridge the Kruskal vacuum pairs a universe \
of Killing energy +eps with a universe of Killing energy -eps.\
\>", "Text",ExpressionUUID->"e4deb2ba-60bc-4d58-8354-e52d04280115"]
},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (July 2, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"19c13e1d-7cb7-4448-a3ff-bbd9386b36e1"
]
