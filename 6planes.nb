Cell["1.2 Proofs by exact computation", "Subsection",ExpressionUUID->"6cb75d25-f5b2-48b3-81bf-aae1d1cf7110"],

Cell["\<\
(a) every entry is a real integer; (b) {T_A, T_B} = 2 eta_AB I16 for all 64 \
pairs; (c) T_A is symmetric for A = 0..3 and antisymmetric for A = 4..7; (d) \
the chirality Gamma = T16A[8] = diag(-I8, I8) anticommutes with all eight; \
(e) P_L, P_R are complementary orthogonal projectors of rank 8; (f) sigma16 = \
diag(-sigma, sigma) is symmetric, squares to I16, has signature (8,8), and \
makes sigma16.T_A and sigma16.S_AB antisymmetric.\
\>", "Text",ExpressionUUID->"fa20bcf8-21d7-471d-9444-bda2f3ba806b"],

Cell["\<\
checksClifford = <|
  \"real integer entries\" -> And @@ Table[MatrixQ[T16A[A], IntegerQ], {A, 0, \
7}],
  \"{T_A,T_B} = 2 eta_AB I\" -> And @@ Flatten@Table[T16A[A].T16A[B] + \
T16A[B].T16A[A] == 2 eta4488[[A + 1, B + 1]] ID16, {A, 0, 7}, {B, 0, 7}],
  \"T_A^T = eta_AA T_A\" -> And @@ Table[Transpose[T16A[A]] == eta4488[[A + \
1, A + 1]] T16A[A], {A, 0, 7}],
  \"Gamma = diag(-I8,I8)\" -> (Gamma5 == ArrayFlatten[{{-ID8, 0}, {0, \
ID8}}]),
  \"{Gamma,T_A} = 0\" -> And @@ Table[Gamma5.T16A[A] + T16A[A].Gamma5 == 0 \
ID16, {A, 0, 7}],
  \"Gamma^2 = I\" -> (Gamma5.Gamma5 == ID16),
  \"P_L, P_R projectors\" -> (PL.PL == PL && PR.PR == PR && PL.PR == 0 ID16 \
&& PL + PR == ID16 && MatrixRank[PL] == 8 == MatrixRank[PR]),
  \"sigma16 = diag(-sigma,sigma)\" -> (sigma16 == ArrayFlatten[{{-sigma, 0}, \
{0, sigma}}]),
  \"sigma16 symmetric, sigma16^2 = I\" -> (Transpose[sigma16] == sigma16 && \
sigma16.sigma16 == ID16),
  \"signature of sigma16\" -> Tally[Eigenvalues[sigma16]],
  \"sigma16.T_A antisymmetric\" -> And @@ Table[Transpose[sigma16.T16A[A]] == \
-sigma16.T16A[A], {A, 0, 7}],
  \"sigma16.S_AB antisymmetric\" -> And @@ \
Flatten@Table[Transpose[sigma16.SAB[[A, B]]] == -sigma16.SAB[[A, B]], {A, 8}, \
{B, 8}]|>\
\>", "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"880b94d6-cd9e-46ff-bc86-c4ec88f5b3fa"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"real integer entries\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"{T_A,T_B} = 2 eta_AB I\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"T_A^T = eta_AA T_A\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Gamma = diag(-I8,I8)\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"{Gamma,T_A} = 0\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Gamma^2 = I\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"P_L, P_R projectors\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"sigma16 = diag(-sigma,sigma)\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"sigma16 symmetric, sigma16^2 = I\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"signature of sigma16\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "8"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"sigma16.T_A antisymmetric\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"sigma16.S_AB antisymmetric\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",ExpressionUUID->"64a72913-d5cb-4858-91c0-755abbfbf4a8"],

Cell["\<\
1.3 The scaled commutators S_AB = (1/4)[T_A, T_B] generate Spin(4,4); with \
the reflections T_A they generate Pin(4,4)\
\>", "Subsection",ExpressionUUID->"9d5ae551-4f3d-49e0-b21f-d37afcf5c5e7"],

Cell["\<\
We verify: (i) [S_AB, S_CD] = eta_BC S_AD - eta_AC S_BD - eta_BD S_AC + \
eta_AD S_BC (the so(4,4) relations); (ii) [S_AB, T_C] = eta_BC T_A - eta_AC \
T_B (vector action); (iii) the 28 matrices S_AB (A<B) are linearly \
independent; (iv) S_AB^2 = -(1/4) eta_AA eta_BB I16, so 12 generators are \
compact (rotations) and 16 non-compact (boosts); (v) g = exp(theta S_AB) acts \
on the vector index by a matrix Lambda(g) with Lambda^T eta Lambda = eta and \
det Lambda = 1; (vi) exp(2 Pi S_AB) = -I16 for compact generators (the 2-to-1 \
covering); (vii) the twisted adjoint action v -> -T_C v T_C^-1 is the \
reflection in the hyperplane orthogonal to e_C (det = -1). By the \
Cartan-Dieudonne theorem every element of O(4,4) is a product of at most 8 \
such reflections, hence the group generated by {exp(theta S_AB)} and {T_C} is \
Pin(4,4), the double cover of O(4,4).\
\>", "Text",ExpressionUUID->"0923f592-b93a-4486-bbc7-37851a34b1c3"],

Cell["\<\
etaE[A_, B_] := eta4488[[A + 1, B + 1]];
Sab[A_, B_] := SAB[[A + 1, B + 1]];
checkSO44 = And @@ Flatten@Table[Sab[A, B].Sab[C, D] - Sab[C, D].Sab[A, B] ==
      etaE[B, C] Sab[A, D] - etaE[A, C] Sab[B, D] - etaE[B, D] Sab[A, C] + \
etaE[A, D] Sab[B, C], {A, 0, 7}, {B, 0, 7}, {C, 0, 7}, {D, 0, 7}];
checkVector = And @@ Flatten@Table[Sab[A, B].T16A[C] - T16A[C].Sab[A, B] == \
etaE[B, C] T16A[A] - etaE[A, C] T16A[B], {A, 0, 7}, {B, 0, 7}, {C, 0, 7}];
gens = Flatten[Table[Sab[A, B], {A, 0, 6}, {B, A + 1, 7}], 1];
rank28 = MatrixRank[Flatten /@ gens];
squares = Union[Flatten[Table[Simplify[Sab[A, B].Sab[A, B] + (1/4) etaE[A, A] \
etaE[B, B] ID16 == 0 ID16], {A, 0, 6}, {B, A + 1, 7}]]];
compactCount = Count[Flatten[Table[etaE[A, A] etaE[B, B], {A, 0, 6}, {B, A + \
1, 7}]], 1];
LambdaOf[g_] := Table[Tr[Inverse[g].T16A[C].g.T16A[D] etaE[D, D]]/16, {D, 0, \
7}, {C, 0, 7}];  (* g^-1 T^C g = Lambda^C_D T^D *)
expS[A_, B_, th_] := MatrixExp[th Sab[A, B]];
checkLorentz = And @@ Flatten@Table[Module[{L = Simplify[LambdaOf[expS[A, B, \
th]], th \\[Element] Reals]},
      {Simplify[Transpose[L].eta4488.L - eta4488] == 0 ID8, Simplify[Det[L]] \
== 1}], {A, 0, 6}, {B, A + 1, 7}];
check2Pi = Union[Flatten@Table[If[etaE[A, A] etaE[B, B] == 1, MatrixExp[2 Pi \
Sab[A, B]] == -ID16, True], {A, 0, 6}, {B, A + 1, 7}]];
reflection[C_] := Table[Tr[-T16A[C].T16A[D].Inverse[T16A[C]].T16A[E] etaE[E, \
E]]/16, {E, 0, 7}, {D, 0, 7}];
checkReflections = Table[{C, Det[reflection[C]], reflection[C] == \
eta4488.(ID8 - 2 Outer[Times, UnitVector[8, C + 1], UnitVector[8, C + \
1]]).eta4488}, {C, 0, 7}];
<|\"so(4,4) commutation relations\" -> checkSO44, \"[S_AB,T_C] = eta_BC T_A - \
eta_AC T_B\" -> checkVector,
 \"rank of the 28 S_AB\" -> rank28, \"S_AB^2 = -(1/4)eta_AA eta_BB I\" -> \
squares, \"compact generators\" -> compactCount,
 \"non-compact generators\" -> 28 - compactCount, \"Lambda(exp(theta S_AB)) \
in SO(4,4)\" -> checkLorentz,
 \"exp(2 Pi S_compact) = -I16\" -> check2Pi, \"reflections {C, det, equals \
diag reflection}\" -> checkReflections|>\
\>", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"6955c706-55b6-42f1-8679-1317442bbbd2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"so(4,4) commutation relations\"\>", "\[Rule]", "True"}], ",", 
   
   RowBox[{"\<\"[S_AB,T_C] = eta_BC T_A - eta_AC T_B\"\>", "\[Rule]", 
    "True"}], ",", 
   RowBox[{"\<\"rank of the 28 S_AB\"\>", "\[Rule]", "28"}], ",", 
   RowBox[{"\<\"S_AB^2 = -(1/4)eta_AA eta_BB I\"\>", "\[Rule]", 
    RowBox[{"{", "True", "}"}]}], ",", 
   RowBox[{"\<\"compact generators\"\>", "\[Rule]", "12"}], ",", 
   RowBox[{"\<\"non-compact generators\"\>", "\[Rule]", "16"}], ",", 
   RowBox[{"\<\"Lambda(exp(theta S_AB)) in SO(4,4)\"\>", "\[Rule]", "True"}], 
   ",", 
   RowBox[{"\<\"exp(2 Pi S_compact) = -I16\"\>", "\[Rule]", 
    RowBox[{"{", "True", "}"}]}], ",", 
   RowBox[{"\<\"reflections {C, det, equals diag reflection}\"\>", "\[Rule]", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "1"}], ",", "True"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", "True"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", 
        RowBox[{"-", "1"}], ",", "True"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", 
        RowBox[{"-", "1"}], ",", "True"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", 
        RowBox[{"-", "1"}], ",", "True"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"5", ",", 
        RowBox[{"-", "1"}], ",", "True"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"6", ",", 
        RowBox[{"-", "1"}], ",", "True"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"7", ",", 
        RowBox[{"-", "1"}], ",", "True"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]=",ExpressionUUID->"0da8419f-a22b-46f2-a07f-39bcae856115"],

Cell["\<\
Example: a rotation in the (x1,x2)-plane (compact) and a boost in the \
(x0,x4)-plane (non-compact) in closed form:\
\>", "Text",ExpressionUUID->"77938a97-7f83-4870-8f99-e225f151f1e7"],

Cell["\<\
{Simplify[expS[1, 2, th] - (Cos[th/2] ID16 + 2 Sin[th/2] Sab[1, 2])] == 0 ID16,
 Simplify[expS[0, 4, th] - (Cosh[th/2] ID16 + 2 Sinh[th/2] Sab[0, 4])] == 0 \
ID16}\
\>", "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"a2c841fb-3622-4d0e-95a4-feb626dfeff5"],

Cell[BoxData[
