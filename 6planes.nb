       TemplateBox[<|"icon" -> "Root", "small" -> InterpretationBox[
           StyleBox[
            TemplateBox[{"\"22.5\"", 
              DynamicBox[
               FEPrivate`FrontEndResource[
               "FEExpressions", "NumericalApproximationElider"]]}, 
             "RowDefault"], ShowStringCharacters -> False], 
           22.47856131037187310539593454450368881226`15.954589770191003, 
           Editable -> False], "approx" -> 22.478561310371873`, "interp" -> 
         InterpretationBox["", 
           Root[-640000 - 160000 # + 373 #^3& , 3, 0]], "head" -> "Root", 
         "big" -> RowBox[{
            RowBox[{
              RowBox[{"-", "640000"}], "-", 
              RowBox[{"160000", " ", "#1"}], "+", 
              RowBox[{"373", " ", 
                SuperscriptBox["#1", "3"]}]}], "&"}], "degree" -> "3", 
         "shortDegree" -> "3", "number" -> 3|>,
        "NumericalApproximationInterp"]}], ",", 
      RowBox[{"\<\"check: g_uu at u=10^-6\"\>", "\[Rule]", 
       "22.47856131037328393312195493671016722837`12."}], ",", 
      RowBox[{"\<\"g_44 at u=0\"\>", "\[Rule]", "0"}], ",", 
      RowBox[{"\<\"metric even in u\"\>", "\[Rule]", "True"}], ",", 
