Cell["\<\
1.4 The 256 products of the T's form a basis of all real 16x16 matrices \
(Cl(4,4) = M(16,R))\
\>", "Subsection",ExpressionUUID->"2bd6cb3b-fed7-4a15-b88d-e5423d005082"],

Cell["\<\
products = Table[Dot @@ (T16A /@ s), {s, Subsets[Range[0, 7], {1, 8}]}];
basis256 = Prepend[products, ID16];
{Length[basis256], MatrixRank[Flatten /@ basis256]}\
\>", "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"42deb7b5-36d6-4773-a2b8-be58ad330794"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"256", ",", "256"}], "}"}]], "Output",
 CellLabel->"Out[6]=",ExpressionUUID->"d19223d1-b336-44fb-bca0-1266748db220"],

Cell["Part 2. A small exact Grassmann-algebra engine", "Section",ExpressionUUID->"8b655f7c-4ffc-4d38-a872-7114c9daad6d"],

Cell["\<\
dirac16complex has 16 complex components psi_a (a = 0..15) and their complex \
conjugates psi_a^*; these 32 objects (and their space-time derivatives) are \
anticommuting Grassmann generators: psi_a psi_b = - psi_b psi_a, in \
particular psi_a^2 = 0. An element of the Grassmann algebra is stored as an \
Association  <| {g1,...,gk} -> coefficient |>  with canonically ordered \
distinct generators. Complex conjugation reverses the order of factors, \
(theta eta)^* = eta^* theta^*, the standard convention compatible with \
Hermitian conjugation of field operators.\
\>", "Text",ExpressionUUID->"b4c650c4-b2ed-4bb9-83ca-b4c79bed0df6"],

Cell["\<\
gClean[assoc_] := Select[DeleteCases[Map[Together, assoc], 0], True &];
gSortSign[list_] := Module[{ord = Ordering[list]}, \
If[Length[DeleteDuplicates[list]] < Length[list], {0, {}}, {Signature[ord], \
list[[ord]]}]];
gFromMono[c_, gens_List] := Module[{s = gSortSign[gens]}, If[s[[1]] == 0 || c \
=== 0, <||>, <|s[[2]] -> s[[1]] c|>]];
gAdd[xs__Association] := gClean[Merge[{xs}, Total]];
gScale[c_, x_Association] := gClean[c # & /@ x];
gMul[x_Association, y_Association] := Module[{res = <||>},
  KeyValueMap[Function[{k1, c1}, KeyValueMap[Function[{k2, c2},
      Module[{s = gSortSign[Join[k1, k2]]}, If[s[[1]] =!= 0, res[s[[2]]] = \
Lookup[res, Key[s[[2]]], 0] + s[[1]] c1 c2]]], y]], x];
  gClean[res]];
gGen[g_] := <|{g} -> 1|>; gNum[c_] := If[c === 0, <||>, <|{} -> c|>];
gDL[g_, x_Association] := gClean[Association @@ KeyValueMap[Function[{k, c},
     With[{pos = FirstPosition[k, g, {0}][[1]]}, If[pos == 0, Nothing, \
Delete[k, pos] -> (-1)^(pos - 1) c]]], x]];   (* left derivative *)
gDR[g_, x_Association] := gClean[Association @@ KeyValueMap[Function[{k, c},
     With[{pos = FirstPosition[k, g, {0}][[1]]}, If[pos == 0, Nothing, \
Delete[k, pos] -> (-1)^(Length[k] - pos) c]]], x]];  (* right derivative *)
gDx[mu_, x_Association, Xs_List] := Module[{res = <||>},   (* total \
derivative d/dx_mu, Leibniz rule, order preserved *)
  KeyValueMap[Function[{k, c}, res = gAdd[res, gFromMono[D[c, Xs[[mu + 1]]], \
k]];
     Do[res = gAdd[res, gFromMono[c, ReplacePart[k, i -> (k[[i]] /. gen[t_, \
a_, d_] :> gen[t, a, Sort[Append[d, mu]]])]]], {i, Length[k]}]], x];
  gClean[res]];
gConjGen[gen[t_, a_, d_]] := gen[If[t === \"psi\", \"psiS\", \"psi\"], a, d];
gConj[x_Association, rule_ : {}] := Module[{res = <||>},
  KeyValueMap[Function[{k, c}, res = gAdd[res, gFromMono[Conjugate[c] /. \
rule, Reverse[gConjGen /@ k]]]], x]; gClean[res]];
psiF[d_ : {}] := Table[gGen[gen[\"psi\", a, d]], {a, 0, 15}];
psiSF[d_ : {}] := Table[gGen[gen[\"psiS\", a, d]], {a, 0, 15}];
gBil[u_List, M_, v_List] := Module[{res = <||>}, Do[If[M[[i, j]] =!= 0, res = \
gAdd[res, gScale[M[[i, j]], gMul[u[[i]], v[[j]]]]]], {i, Length[u]}, {j, \
Length[v]}]; res];
gMatVec[M_, v_List] := Table[Module[{res = <||>}, Do[If[M[[i, j]] =!= 0, res \
= gAdd[res, gScale[M[[i, j]], v[[j]]]]], {j, Length[v]}]; res], {i, \
Length[M]}];
gVecAdd[u_List, v_List] := MapThread[gAdd, {u, v}]; gVecScale[c_, u_List] := \
gScale[c, #] & /@ u;
gZeroQ[x_Association] := Length[gClean[x]] == 0;
gSimplify[x_Association, assum_ : True] := gClean[Simplify[#, assum] & /@ x];
gLinSub[x_Association, rule_] := Module[{res = <||>},
  KeyValueMap[Function[{k, c}, res = gAdd[res, gScale[c, If[k === {}, \
gNum[1], Fold[gMul, rule /@ k]]]]], x]; res];
p1 = gGen[gen[\"psi\", 1, {}]]; p2 = gGen[gen[\"psi\", 2, {}]]; s1 = \
gGen[gen[\"psiS\", 1, {}]];
<|\"psi1 psi2 + psi2 psi1 = 0\" -> gZeroQ[gAdd[gMul[p1, p2], gMul[p2, p1]]], \
\"psi1^2 = 0\" -> gZeroQ[gMul[p1, p1]],
 \"(psi1^* psi1)^* = psi1^* psi1\" -> gZeroQ[gAdd[gConj[gMul[s1, p1]], \
gScale[-1, gMul[s1, p1]]]]|>\
\>", "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"bf254ec1-4861-478d-9f93-f0d472ef727e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"psi1 psi2 + psi2 psi1 = 0\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"psi1^2 = 0\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"(psi1^* psi1)^* = psi1^* psi1\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[7]=",ExpressionUUID->"ab5f9997-c93f-4a2c-90ff-4c48e7368c8b"],

Cell["Part 3. The field dirac16complex and its Lagrangian", "Section",ExpressionUUID->"14c76f74-dcdd-41b3-b9c8-9f8aa17b13cf"],

Cell["3.1 Definition", "Subsection",ExpressionUUID->"023f4212-b9d7-4b8a-8601-36d68026cd51"],

Cell["\<\
dirac16complex(x) = (psi_0(x), ..., psi_15(x)) is a 16-component Pin(4,4) \
spinor field on R^(4,4) with coordinates X. Each component is complex and \
Grassmann-odd: psi_a = (xi_a + I chi_a)/Sqrt[2] with xi_a, chi_a real \
Grassmann generators. Its Dirac adjoint is psibar = psi^dagger.sigma16 (the \
16x16 version of the spinor metric of Pre-gravity6plane.nb). Under Spin(4,4), \
psi -> g psi with g = exp((1/2) omega^AB S_AB), and psibar psi is invariant \
because sigma16.S_AB is antisymmetric (Part 1).
dirac16complex is a SECOND-QUANTIZED field: the psi_a are operator-valued; \
the Grassmann variables used here are the classical (path-integral) \
counterparts of those operators. A c-number solution of the field equation (a \
\"Universe\", in the language of Pre-gravity6plane.nb) is a mode function of \
the field operator.\
\>", "Text",ExpressionUUID->"e2d6ed70-2f7a-49dc-89f4-79efb069e9ac"],

Cell["\<\
3.2 The Lagrangian: kinetic + mass (quadratic) + self-coupling (quartic)\
\>", "Subsection",ExpressionUUID->"a27ba1fd-d35e-4271-99b0-84847b820914"],

Cell["\<\
L = (1/2) (psibar T^A d_A psi - (d_A psibar) T^A psi) - m psibar psi - \
(lam/2) (psibar psi)^2 .
The mass term is quadratic and the self-coupling quartic in the spinor \
components, in analogy with the Higgs potential mu^2 |phi|^2 + lambda |phi|^4 \
(the Higgs is a boson; here the field is a fermion, so (psibar psi)^2 is the \
lowest non-trivial self-coupling). Both terms are non-zero because the \
components are complex: for a real (Majorana) 16-component Grassmann field \
xi^T.sigma16.xi = 0 identically since sigma16 is symmetric.\
\>", "Text",ExpressionUUID->"9d512541-0e21-4392-9886-d50056e6c468"],

Cell["\<\
psi = psiF[]; psiS = psiSF[]; dpsi[mu_] := psiF[{mu}]; dpsiS[mu_] := \
psiSF[{mu}];
Sbil = gBil[psiS, sigma16, psi];                                    (* psibar \
psi *)
kin1 = gAdd @@ Table[gBil[psiS, sigma16.T16A[A], dpsi[A]], {A, 0, 7}];   (* \
psibar T^A d_A psi *)
kin2 = gAdd @@ Table[gBil[dpsiS[A], sigma16.T16A[A], psi], {A, 0, 7}];   (* \
(d_A psibar) T^A psi *)
Lflat = gAdd[gScale[1/2, kin1], gScale[-1/2, kin2], gScale[-m, Sbil], \
gScale[-lam/2, gMul[Sbil, Sbil]]];
realRule = {Conjugate[m] -> m, Conjugate[lam] -> lam};
<|\"number of Grassmann monomials in L\" -> Length[Lflat], \"mass term \
non-zero\" -> (Length[Sbil] > 0), \"quartic term non-zero\" -> \
(Length[gMul[Sbil, Sbil]] > 0),
 \"L is real: L^* - L = 0\" -> gZeroQ[gAdd[gConj[Lflat, realRule], gScale[-1, \
Lflat]]]|>\
\>", "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"f1a35bc4-fb3b-4a81-b160-ed640274767c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"number of Grassmann monomials in L\"\>", "\[Rule]", "392"}], ",", 
   RowBox[{"\<\"mass term non-zero\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"quartic term non-zero\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"L is real: L^* - L = 0\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[8]=",ExpressionUUID->"67660531-ffde-4ccb-a8d3-aa3ed0292da6"],

Cell["\<\
3.3 Euler-Lagrange equations (flat space), derived with Grassmann derivatives\
\
\>", "Subsection",ExpressionUUID->"b5e4efba-b29b-4728-8ab3-899ef7e2e8b6"],

Cell["\<\
Varying psi_a^* (left derivatives): dL/dpsi_a^* - d_mu ( dL/d(d_mu psi_a^*) ) \
= 0. We compare the 16 resulting Grassmann expressions with the matrix form \
sigma16.(T^A d_A psi - m psi - lam (psibar psi) psi).\
\>", "Text",ExpressionUUID->"3b6922ff-7160-4a9a-ac39-1e1a059b5178"],

Cell["\<\
ELflat = Table[gAdd[gDL[gen[\"psiS\", a, {}], Lflat], gScale[-1, gAdd @@ \
Table[gDx[mu, gDL[gen[\"psiS\", a, {mu}], Lflat], X], {mu, 0, 7}]]], {a, 0, \
15}];
Tdpsi = Fold[gVecAdd, Table[gMatVec[T16A[A], dpsi[A]], {A, 0, 7}]];
expectedFlat = gMatVec[sigma16, gVecAdd[gVecAdd[Tdpsi, gVecScale[-m, psi]], \
gVecScale[-lam, Table[gMul[Sbil, psi[[b]]], {b, 16}]]]];
ELbFlat = Table[gAdd[gDR[gen[\"psi\", a, {}], Lflat], gScale[-1, gAdd @@ \
Table[gDx[mu, gDR[gen[\"psi\", a, {mu}], Lflat], X], {mu, 0, 7}]]], {a, 0, \
15}];
<|\"EL(psi^*) == sigma16.(T^A d_A psi - m psi - lam (psibar psi) psi)\" -> \
And @@ MapThread[gZeroQ[gAdd[#1, gScale[-1, #2]]] &, {ELflat, expectedFlat}],
 \"EL(psi) == complex conjugate of EL(psi^*)\" -> And @@ \
MapThread[gZeroQ[gAdd[#1, gScale[-1, gConj[#2, realRule]]]] &, {ELbFlat, \
ELflat}]|>\
\>", "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"7469728a-ee9b-403c-8255-facfd74a25fc"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"EL(psi^*) == sigma16.(T^A d_A psi - m psi - lam (psibar psi) \
psi)\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"EL(psi) == complex conjugate of EL(psi^*)\"\>", "\[Rule]", 
    "True"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[9]=",ExpressionUUID->"f569b041-b649-4c51-a931-84133c6ffdd9"],

Cell["\<\
Result (field equation of dirac16complex in flat space):  T^A d_A psi = (m + \
lam psibar psi) psi ,  A summed over 0..7 with T^A = T16A[A].  Example: the \
first component, written out:\
\>", "Text",ExpressionUUID->"487a816e-bb44-4074-b489-f6b93a9b7a25"],

Cell["\<\
showG[x_] := Total[KeyValueMap[#2 (Times @@ (#1 /. {gen[\"psi\", a_, {}] :> \
Subscript[\\[Psi], a], gen[\"psi\", a_, {mu_}] :> Subscript[\"\\[PartialD]\", \
mu][Subscript[\\[Psi], a]], gen[\"psiS\", a_, {}] :> Subscript[\\[Psi], \
a]^\"*\"})) &, x]];
showG[ELflat[[1]] /. lam -> 0]\
\>", "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"4a5e864f-9bbd-469d-9e71-ffe2e1012348"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m", " ", 
   SubscriptBox["\[Psi]", "4"]}], "-", 
  RowBox[{
   SubscriptBox["\<\"\[PartialD]\"\>", "0"], "[", 
   SubscriptBox["\[Psi]", "12"], "]"}], "+", 
  RowBox[{
   SubscriptBox["\<\"\[PartialD]\"\>", "1"], "[", 
   SubscriptBox["\[Psi]", "11"], "]"}], "-", 
  RowBox[{
   SubscriptBox["\<\"\[PartialD]\"\>", "2"], "[", 
   SubscriptBox["\[Psi]", "10"], "]"}], "+", 
  RowBox[{
   SubscriptBox["\<\"\[PartialD]\"\>", "3"], "[", 
   SubscriptBox["\[Psi]", "9"], "]"}], "-", 
  RowBox[{
   SubscriptBox["\<\"\[PartialD]\"\>", "4"], "[", 
   SubscriptBox["\[Psi]", "9"], "]"}], "+", 
  RowBox[{
   SubscriptBox["\<\"\[PartialD]\"\>", "5"], "[", 
   SubscriptBox["\[Psi]", "10"], "]"}], "+", 
  RowBox[{
   SubscriptBox["\<\"\[PartialD]\"\>", "6"], "[", 
   SubscriptBox["\[Psi]", "11"], "]"}], "+", 
  RowBox[{
   SubscriptBox["\<\"\[PartialD]\"\>", "7"], "[", 
   SubscriptBox["\[Psi]", "12"], "]"}]}]], "Output",
 CellLabel->"Out[10]=",ExpressionUUID->"56caee61-995b-4c7a-ad9a-73a1b6c5a83a"],

Cell["3.4 Noether current and its conservation", "Subsection",ExpressionUUID->"112f041c-b53b-410e-a1d0-da8f72bcabef"],

Cell["\<\
The U(1) symmetry psi -> Exp[I alpha] psi gives the conserved current J^A = \
psibar T^A psi. We verify d_A J^A = 0 when the field equations hold, by \
checking the algebraic identity d_A J^A = (EL-equation of psi) terms, i.e. \
d_A J^A = psibar.(T^A d_A psi) + (d_A psibar) T^A psi, and using the field \
equation T^A d_A psi = (m + lam S) psi together with its adjoint.\
\>", "Text",ExpressionUUID->"7abf06a5-a468-48d2-95fb-9b980df115c1"],

Cell["\<\
J = Table[gBil[psiS, sigma16.T16A[A], psi], {A, 0, 7}];
divJ = gAdd @@ Table[gDx[A, J[[A + 1]], X], {A, 0, 7}];
(* on-shell substitution: replace T^A d_A psi by (m + lam S) psi inside \
psibar(...) and its adjoint *)
onShell = gAdd[gBil[psiS, sigma16, Table[gAdd[gScale[m, psi[[b]]], \
gScale[lam, gMul[Sbil, psi[[b]]]]], {b, 16}]],
   gScale[-1, gConj[gBil[psiS, sigma16, Table[gAdd[gScale[m, psi[[b]]], \
gScale[lam, gMul[Sbil, psi[[b]]]]], {b, 16}]], realRule]]];
<|\"d_A J^A = psibar(T.d psi) + (d psibar T)psi identity\" -> \
gZeroQ[gAdd[divJ, gScale[-1, gAdd[kin1, kin2]]]],
 \"on-shell value of d_A J^A\" -> If[gZeroQ[onShell], 0, onShell]|>\
\>", "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"32ff5a8f-6926-4402-8ce0-ab6d911e815a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"d_A J^A = psibar(T.d psi) + (d psibar T)psi identity\"\>", "\[Rule]",
     "True"}], ",", 
   RowBox[{"\<\"on-shell value of d_A J^A\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[11]=",ExpressionUUID->"93003c3b-d657-44e1-bd3b-4a4616399642"],

Cell["\<\
3.5 Second quantization: canonical anticommutators and the Krein form\
\>", "Subsection",ExpressionUUID->"da92cae6-6555-4ee3-8ea0-0ce190ea1d34"],

Cell["\<\
Quantizing with x4 as time, the momentum conjugate to psi is pi = psibar T^4, \
and {psi_a(x), pi_b(y)} = I delta_ab delta(x-y) gives {psi_a, psi_b^dagger} = \
K_ab delta(x-y) with K = -I sigma16.T^4. K is Hermitian, K^2 = I16, with \
eight eigenvalues +1 and eight -1: the Fock space of dirac16complex carries \
an INDEFINITE (Krein) metric. This is unavoidable: the rotation by Pi in the \
(x4,x5)-plane, g45 = T16A[4].T16A[5] in Spin(4,4), maps K -> -K, so no \
Spin(4,4)-covariant positive charge density exists (with four time directions \
there is no invariant notion of 'positive time').\
\>", "Text",ExpressionUUID->"a360482e-a28a-4d64-b498-ab042b4c0d4b"],

Cell["\<\
K = -I sigma16.T16A[4];
g45 = T16A[4].T16A[5];
alphaKS = -T16A[4].T16A[0]; betaKS = -I T16A[4];
<|\"K Hermitian\" -> (K == ConjugateTranspose[K]), \"K^2 = I\" -> (K.K == \
ID16), \"eigenvalues of K\" -> Tally[Eigenvalues[K]],
 \"g45 = exp(Pi S_45) up to sign\" -> (MatrixExp[Pi Sab[4, 5]] == g45 || \
MatrixExp[Pi Sab[4, 5]] == -g45),
 \"g45^T.(sigma16 T^4).g45 = -(sigma16 T^4)\" -> \
(Transpose[g45].sigma16.T16A[4].g45 == -sigma16.T16A[4]),
 \"sigma16 = K.beta\" -> (sigma16 == K.betaKS)|>\
\>", "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"3e058a12-9606-40e2-acf3-baecd619093a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"K Hermitian\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"K^2 = I\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"eigenvalues of K\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "8"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "8"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"g45 = exp(Pi S_45) up to sign\"\>", "\[Rule]", "True"}], ",", 
   
   RowBox[{"\<\"g45^T.(sigma16 T^4).g45 = -(sigma16 T^4)\"\>", "\[Rule]", 
    "True"}], ",", 
   RowBox[{"\<\"sigma16 = K.beta\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[12]=",ExpressionUUID->"7b19ca09-0ce5-4016-931f-de0c7b0df64a"],

Cell["3.6 The two mirror sectors: +mass and -mass universes", "Subsection",ExpressionUUID->"3cbf71ec-f973-47d7-8e50-07cd7caa7867"],

Cell["\<\
Since sigma16 = K.beta with beta = -I T^4, and K commutes with T^0, T^1, T^2, \
T^3, T^4 (but anticommutes with T^5, T^6, T^7), every field that does not \
depend on the superluminal times x5, x6, x7 splits as psi = psi_+ + psi_- \
with K psi_(+/-) = (+/-) psi_(+/-), and the Lagrangian splits EXACTLY into \
two copies with opposite overall sign:
L = L_D[psi_+] - L_D[psi_-] - (lam/2)(S_+ - S_-)^2 ,  L_D[chi] = chi^dagger \
beta (T^A d_A - m) chi (A = 0..4),  S_(+/-) = psi_(+/-)^dagger beta \
psi_(+/-).
So the 16-component field is a pair of 8-component universes whose energies \
(masses) enter with opposite signs. The quartic term couples them through \
-lam S_+ S_-.\
\>", "Text",ExpressionUUID->"33c76be4-b781-45bd-8119-826b49a9ead3"],

Cell["\<\
<|\"[K,T^A] = 0 for A=0..4\" -> Table[K.T16A[A] == T16A[A].K, {A, 0, 4}], \
\"{K,T^A} = 0 for A=5..7\" -> Table[K.T16A[A] == -T16A[A].K, {A, 5, 7}],
 \"Pplus.sigma16.T^A.Pminus = 0 (A=0..4): no cross terms\" -> Table[(ID16 + \
K).sigma16.T16A[A].(ID16 - K) == 0 ID16, {A, 0, 4}],
 \"Pplus.sigma16.Pplus == Pplus.beta.Pplus\" -> ((ID16 + K).sigma16.(ID16 + \
K) == (ID16 + K).betaKS.(ID16 + K)),
 \"Pminus.sigma16.Pminus == -Pminus.beta.Pminus\" -> ((ID16 - \
K).sigma16.(ID16 - K) == -(ID16 - K).betaKS.(ID16 - K))|>\
\>", "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"7ca4e6c3-9729-432e-a00d-47035bf7e681"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"[K,T^A] = 0 for A=0..4\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"{K,T^A} = 0 for A=5..7\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"Pplus.sigma16.T^A.Pminus = 0 (A=0..4): no cross terms\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"Pplus.sigma16.Pplus == Pplus.beta.Pplus\"\>", "\[Rule]", 
    "True"}], ",", 
   RowBox[{"\<\"Pminus.sigma16.Pminus == -Pminus.beta.Pminus\"\>", "\[Rule]", 
    "True"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[13]=",ExpressionUUID->"a7914eff-db19-4516-b1a6-c4e451696071"],

Cell["\<\
Part 4. Mirroring Pre-gravity6plane.nb: dirac16complex depending on x0 and x4\
\
\>", "Section",ExpressionUUID->"2a7de83c-5c67-4239-b3fe-8a9985fda076"],

Cell["\<\
Pre-gravity6plane.nb studied Psi16 = f16[k][x0, x4], a 16-component wave \
function of a Universe that depends only on the hidden coordinate x0 and the \
time x4, with Lagrangian La = (1/H) Psi16^T.sigma16.Sum T^A d_A Psi16 + (2 \
M/H) Psi16^T.sigma16.Psi16. The corresponding configurations of \
dirac16complex are those that depend only on x0 and x4 (no dependence on x1, \
x2, x3, x5, x6, x7). For them the field equation is T^0 d0 psi + T^4 d4 psi = \
(m + lam psibar psi) psi. Comparing with the old notebook, whose field \
equation is T^A d_A Psi16 + 2 M Psi16 = 0, the old mass parameter corresponds \
to m = -2 M.\
\>", "Text",ExpressionUUID->"94147c9f-202c-4b38-acee-37dc1d00dfeb"],

Cell["\<\
4.1 The Euler-Lagrange equations of dirac16complex depending on x0 and x4 \
(analogue of eLa)\
\>", "Subsection",ExpressionUUID->"9977da97-07e6-4153-b9a8-81d7b54747c8"],

Cell["\<\
Lx0x4 = gAdd[gScale[1/2, gAdd @@ Table[gBil[psiS, sigma16.T16A[A], dpsi[A]], \
{A, {0, 4}}]],
   gScale[-1/2, gAdd @@ Table[gBil[dpsiS[A], sigma16.T16A[A], psi], {A, {0, \
4}}]], gScale[-m, Sbil], gScale[-lam/2, gMul[Sbil, Sbil]]];
eLax0x4 = Table[gAdd[gDL[gen[\"psiS\", a, {}], Lx0x4], gScale[-1, gAdd @@ \
Table[gDx[mu, gDL[gen[\"psiS\", a, {mu}], Lx0x4], X], {mu, {0, 4}}]]], {a, 0, \
15}];
(* readable c-number form of the linear part (lam = 0):  rows of sigma16.(T^0 \
d0 + T^4 d4 - m) acting on f[k][x0,x4] *)
fvec = Table[f[k][x0, x4], {k, 0, 15}];
eLax0x4c = Simplify[sigma16.(T16A[0].D[fvec, x0] + T16A[4].D[fvec, x4] - m \
fvec)];
Column[eLax0x4c]\
\>", "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"ded75170-c140-42b4-84f7-596d44ad4f6d"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{
      RowBox[{"m", " ", 
       RowBox[{
        RowBox[{"f", "[", "4", "]"}], "[", 
        RowBox[{"x0", ",", "x4"}], "]"}]}], "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"f", "[", "9", "]"}], 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "1"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"x0", ",", "x4"}], "]"}], "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"f", "[", "12", "]"}], 
        TagBox[
         RowBox[{"(", 
          RowBox[{"1", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"x0", ",", "x4"}], "]"}]}]},
    {
     RowBox[{
      RowBox[{"m", " ", 
       RowBox[{
        RowBox[{"f", "[", "5", "]"}], "[", 
