 CellLabel->"Out[20]=",ExpressionUUID->"0104fc5a-0516-499e-9a45-f5050c41be09"],

Cell["\<\
A pair of universes creates a 6-plane by itself: superpose a positive-energy \
and a negative-energy mode. Then Re V2 and Im V2 are independent and M6pair = \
{Z : Re V2.Z = 0, Im V2.Z = 0} is a 6-plane that moves with (x0, x4).\
\>", "Text",ExpressionUUID->"7612e831-0e3f-4254-a5c8-75a54f0d628c"],

Cell["\<\
psiPair = modeFunction[3/4, 1, UnitVector[16, 1], +1] + modeFunction[3/4, 1, \
UnitVector[16, 10], -1];
W2 = Simplify[vectorFormOfType2[psiPair[[9 ;; 16]]]];
{r1, r2} = Simplify[ComplexExpand[{Re[W2], Im[W2]}], {x0, x4} \\[Element] \
Reals];
<|\"pair solves field equation\" -> (Simplify[T16A[0].D[psiPair, x0] + \
T16A[4].D[psiPair, x4] - psiPair] == ConstantArray[0, 16]),
 \"rank {Re V2, Im V2} at sample point\" -> MatrixRank[N[{r1, r2} /. pt]]|>\
\>", "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"478cd928-2b18-40f7-9397-e18eb63ba047"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"pair solves field equation\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"rank {Re V2, Im V2} at sample point\"\>", "\[Rule]", "2"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[21]=",ExpressionUUID->"66c5f8d9-5bf6-4c75-bef2-5c953702d3b1"],

Cell["\<\
Plot[Evaluate[{r1[[1]], r1[[4]], r2[[1]], r2[[4]]} /. x0 -> 0], {x4, 0, 10}, \
PlotLegends -> {\"Re V2[1]\", \"Re V2[4]\", \"Im V2[1]\", \"Im V2[4]\"}, \
PlotLabel -> \"normals of the pair 6-plane M6pair at x0 = 0 as functions of \
the time x4\", AxesLabel -> {\"x4\", None}]\
\>", "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"5ca73e44-9b80-49f1-83d3-9f90fb3b8ca7"],

