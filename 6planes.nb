Cell["\<\
6.4 Kohn-Sham fermion-gas thermodynamic effective potential Omega(T)\
\>", "Subsection",ExpressionUUID->"097ca74d-6d68-4aab-8123-b427c09a9a92"],

Cell["\<\
Mermin-Kohn-Sham grand potential at temperature T (chemical potential 0) for \
vacuum V1: Omega = 8 Sum_k ( -s_k - 2 T Log[1 + Exp[-s_k/T]] ) - (lam/2) \
Integral B rho_s^2 d rho, with rho_s = -Sum_k Tanh[s_k/(2T)] (density of \
level k), solved self-consistently at each T. The Hawking temperatures of the \
bridges of Part 8 are T_H = f'(x_h)/(4 Pi): modern T_H = 1/(4 Pi rs).\
\>", "Text",ExpressionUUID->"6dfaf9af-8483-46c4-a475-aef5667bdece"],

Cell["\<\
THmodern = 1/(4 Pi rsn);
thermo = Table[Module[{xmap, Bfun, rL, rR, n, d, rv, Bv},
    {xmap, Bfun, {rL, rR}} = maps[c]; n = Round[(rR - rL)/dgrid]; d = (rR - \
rL)/n;
    rv = Table[rL + (j - 1/2) d, {j, n}]; Bv = Bfun /@ (xmap /@ rv);
    {c, Table[With[{th = dftSCF[Bv, d, mn, lamn, +1, 0, T]}, {T, th[\"E\"], \
Mean[th[\"M\"]]}], {T, {N[THmodern], 0.25, 0.5, 1., 2.}}]}], {c, \
Keys[maps]}];
TableForm[thermo]\
\>", "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"3202489d-a4a8-49f5-8822-4754c3fadb2a"],

