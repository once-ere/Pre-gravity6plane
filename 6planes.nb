Cell["\<\
Part 5 (appended). Euler-Lagrange equations of dirac16complex in the \
primordial, modern and future gravitational fields\
\>", "Section",ExpressionUUID->"0f1ac174-c3ba-4c23-a74e-544a02aaba35"],

Cell["\<\
A gravitational field is described by a co-frame (vielbein) e^A_mu, metric \
g_mu nu = eta_AB e^A_mu e^B_nu. We use diagonal vielbeins of the form found \
in Pre-gravity6plane.nb:
PRIMORDIAL field (exactly the vielbein of Pre-gravity6plane.nb with the \
inflationary choice a4[H x4] = H x4): e = diag( Tan[6 H x0], E^(-H x4) Sin[6 \
H x0]^(-1/6) (3 times), 1, E^(H x4) Sin[6 H x0]^(-1/6) (3 times) ), 0 < 6 H \
x0 < Pi/2.
MODERN field (static field of a mass along the hidden direction, \
Schwarzschild-type profile f = 1 - rs/x0): e = diag( f^(-1/2), 1, 1, 1, \
f^(1/2), 1, 1, 1 ), x0 > rs.
FUTURE field (mass plus dark energy, Schwarzschild-de Sitter-type profile f = \
1 - rs/x0 - HL^2 x0^2): e = diag( f^(-1/2), 1, 1, 1, f^(1/2), 1, 1, 1 ), \
between the two horizons.
The covariant Lagrangian is L = Sqrt|g| [ (1/2)(psibar gamma^mu D_mu psi - \
(D_mu psibar) gamma^mu psi) - m psibar psi - (lam/2)(psibar psi)^2 ], \
gamma^mu = E_A^mu T^A, D_mu psi = d_mu psi + Omega_mu psi, D_mu psibar = d_mu \
psibar - psibar Omega_mu, Omega_mu = (1/4) omega_mu^A_B gamma_A gamma^B, \
omega_mu^A_B = e^A_nu (d_mu E_B^nu + Gamma^nu_{mu lambda} E_B^lambda). The \
sign of Omega is fixed by demanding covariant constancy of gamma^mu (checked \
below).\
\>", "Text",ExpressionUUID->"d12a849e-0b74-488c-b398-196576a37b76"],

Cell["\<\
spinConnection[Evec_List, Xs_List] := Module[{e = DiagonalMatrix[Evec], Ei, \
g, gi, Gam, om, n = Length[Xs], Om, gam},
  Ei = Inverse[e]; g = Transpose[e].eta4488.e; gi = Inverse[g];
  Gam = Table[Simplify[(1/2) Sum[gi[[i, l]] (D[g[[l, j]], Xs[[k]]] + D[g[[l, \
k]], Xs[[j]]] - D[g[[j, k]], Xs[[l]]]), {l, n}]], {i, n}, {j, n}, {k, n}];
  om = Table[Simplify[Sum[e[[A, nu]] (D[Ei[[nu, B]], Xs[[mu]]] + Sum[Gam[[nu, \
mu, la]] Ei[[la, B]], {la, n}]), {nu, n}]], {mu, n}, {A, n}, {B, n}];
  Om = Table[Simplify[(1/4) Sum[om[[mu, A, B]] eta4488[[A, A]] T16A[A - \
1].T16A[B - 1], {A, n}, {B, n}]], {mu, n}];
  gam = Table[Sum[Ei[[nu, A]] T16A[A - 1], {A, n}], {nu, n}];
  <|\"Omega\" -> Om, \"Gamma\" -> Gam, \"gam\" -> gam, \"g\" -> g|>];
covConst[sc_] := And @@ Flatten[Table[Simplify[D[sc[\"gam\"][[nu]], X[[mu]]] \
+ Sum[sc[\"Gamma\"][[nu, mu, la]] sc[\"gam\"][[la]], {la, 8}] + \
sc[\"Omega\"][[mu]].sc[\"gam\"][[nu]] - \
sc[\"gam\"][[nu]].sc[\"Omega\"][[mu]]] == 0 ID16, {mu, 8}, {nu, 8}]];
fM = 1 - rs/x0; fF = 1 - rs/x0 - HL^2 x0^2;
fields = <|
  \"primordial\" -> {Tan[6 H x0], E^(-H x4) Sin[6 H x0]^(-1/6), E^(-H x4) \
Sin[6 H x0]^(-1/6), E^(-H x4) Sin[6 H x0]^(-1/6), 1, E^(H x4) Sin[6 H \
x0]^(-1/6), E^(H x4) Sin[6 H x0]^(-1/6), E^(H x4) Sin[6 H x0]^(-1/6)},
  \"modern\" -> {fM^(-1/2), 1, 1, 1, fM^(1/2), 1, 1, 1},
  \"future\" -> {fF^(-1/2), 1, 1, 1, fF^(1/2), 1, 1, 1}|>;
realX = Element[{x0, x1, x2, x3, x4, x5, x6, x7}, Reals];
assum = <|\"primordial\" -> (H > 0 && 0 < x0 < Pi/(12 H) && realX), \
\"modern\" -> (rs > 0 && x0 > rs && realX), \"future\" -> (rs > 0 && HL > 0 \
&& x0 > rs && fF > 0 && realX)|>;
realRuleG = {Conjugate[m] -> m, Conjugate[lam] -> lam, Conjugate[H] -> H, \
Conjugate[rs] -> rs, Conjugate[HL] -> HL, Conjugate[x0] -> x0, Conjugate[x4] \
-> x4};
gravityEL = <||>;
Do[Module[{sc = spinConnection[fields[c], X], Om, gam, sqrtg, k1, k2, s1, s2, \
L, EL, Dpsi, expected, spin},
   Om = sc[\"Omega\"]; gam = sc[\"gam\"];
   sqrtg = Simplify[Sqrt[Abs[Det[sc[\"g\"]]]], assum[c]];
   k1 = gAdd @@ Table[gBil[psiS, sigma16.gam[[mu + 1]], dpsi[mu]], {mu, 0, 7}];
   k2 = gAdd @@ Table[gBil[dpsiS[mu], sigma16.gam[[mu + 1]], psi], {mu, 0, 7}];
   s1 = gBil[psiS, Simplify[sigma16.Sum[gam[[mu]].Om[[mu]], {mu, 8}]], psi];
   s2 = gBil[psiS, Simplify[sigma16.Sum[Om[[mu]].gam[[mu]], {mu, 8}]], psi];
   L = gScale[sqrtg, gAdd[gScale[1/2, k1], gScale[1/2, s1], gScale[-1/2, k2], \
gScale[1/2, s2], gScale[-m, Sbil], gScale[-lam/2, gMul[Sbil, Sbil]]]];
   EL = Table[gSimplify[gAdd[gDL[gen[\"psiS\", a, {}], L], gScale[-1, gAdd @@ \
Table[gDx[mu, gDL[gen[\"psiS\", a, {mu}], L], X], {mu, 0, 7}]]], assum[c]], \
{a, 0, 15}];
   Dpsi = Fold[gVecAdd, Table[gMatVec[gam[[mu + 1]], gVecAdd[dpsi[mu], \
gMatVec[Om[[mu + 1]], psi]]], {mu, 0, 7}]];
   expected = gMatVec[sqrtg sigma16, gVecAdd[gVecAdd[Dpsi, gVecScale[-m, \
psi]], gVecScale[-lam, Table[gMul[Sbil, psi[[b]]], {b, 16}]]]];
   spin = Simplify[Sum[gam[[mu]].Om[[mu]], {mu, 8}], assum[c]];
   gravityEL[c] = <|\"covariantly constant gamma^mu\" -> covConst[sc], \
\"Sqrt|g|\" -> sqrtg,
     \"L real\" -> gZeroQ[gSimplify[gAdd[gConj[L, realRuleG], gScale[-1, L]], \
assum[c]]],
     \"EL == Sqrt|g| sigma16 (gamma^mu D_mu psi - m psi - lam S psi)\" -> \
(And @@ MapThread[gZeroQ[gSimplify[gAdd[#1, gScale[-1, #2]], assum[c]]] &, \
{EL, expected}]),
     \"gamma^mu Omega_mu (coefficient of T^0; all other T^A coefficients \
vanish)\" -> {Simplify[Tr[spin.T16A[0]]/16, assum[c]], \
Table[Simplify[Tr[spin.T16A[A]], assum[c]], {A, 1, 7}]},
     \"gamma^mu (E_A^mu factors)\" -> Table[Simplify[1/fields[c][[A + 1]], \
assum[c]], {A, 0, 7}]|>], {c, Keys[fields]}];
gravityEL\
\>", "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"9cd9e728-d989-4c89-b1d0-c2e60ec7a29f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"primordial\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"covariantly constant gamma^mu\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"Sqrt|g|\"\>", "\[Rule]", 
       RowBox[{"Sec", "[", 
        RowBox[{"6", " ", "H", " ", "x0"}], "]"}]}], ",", 
      RowBox[{"\<\"L real\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"EL == Sqrt|g| sigma16 (gamma^mu D_mu psi - m psi - lam S \
psi)\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"gamma^mu Omega_mu (coefficient of T^0; all other T^A \
coefficients vanish)\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "3"}], " ", "H", " ", 
          SuperscriptBox[
           RowBox[{"Cot", "[", 
            RowBox[{"6", " ", "H", " ", "x0"}], "]"}], "2"]}], ",", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
          "}"}]}], "}"}]}], ",", 
      RowBox[{"\<\"gamma^mu (E_A^mu factors)\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cot", "[", 
          RowBox[{"6", " ", "H", " ", "x0"}], "]"}], ",", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"H", " ", "x4"}]], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
            RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
           RowBox[{"1", "/", "6"}]]}], ",", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"H", " ", "x4"}]], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
            RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
           RowBox[{"1", "/", "6"}]]}], ",", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"H", " ", "x4"}]], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
            RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
           RowBox[{"1", "/", "6"}]]}], ",", "1", ",", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "H"}], " ", "x4"}]], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
            RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
           RowBox[{"1", "/", "6"}]]}], ",", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "H"}], " ", "x4"}]], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
            RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
           RowBox[{"1", "/", "6"}]]}], ",", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "H"}], " ", "x4"}]], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
            RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
           RowBox[{"1", "/", "6"}]]}]}], "}"}]}]}], "\[RightAssociation]"}]}],
    ",", 
   RowBox[{"\<\"modern\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"covariantly constant gamma^mu\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"Sqrt|g|\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"L real\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"EL == Sqrt|g| sigma16 (gamma^mu D_mu psi - m psi - lam S \
psi)\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"gamma^mu Omega_mu (coefficient of T^0; all other T^A \
coefficients vanish)\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["rs", 
          RowBox[{"4", " ", 
           SqrtBox[
            RowBox[{
             SuperscriptBox["x0", "3"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "rs"}], "+", "x0"}], ")"}]}]]}]], ",", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
          "}"}]}], "}"}]}], ",", 
      RowBox[{"\<\"gamma^mu (E_A^mu factors)\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         SqrtBox[
          RowBox[{"1", "-", 
           FractionBox["rs", "x0"]}]], ",", "1", ",", "1", ",", "1", ",", 
         FractionBox["1", 
          SqrtBox[
           RowBox[{"1", "-", 
            FractionBox["rs", "x0"]}]]], ",", "1", ",", "1", ",", "1"}], 
        "}"}]}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"future\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"covariantly constant gamma^mu\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"Sqrt|g|\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"L real\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"EL == Sqrt|g| sigma16 (gamma^mu D_mu psi - m psi - lam S \
psi)\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"gamma^mu Omega_mu (coefficient of T^0; all other T^A \
coefficients vanish)\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         FractionBox[
          RowBox[{"rs", "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["HL", "2"], " ", 
            SuperscriptBox["x0", "3"]}]}], 
          RowBox[{"4", " ", 
           SqrtBox[
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox["x0", "3"]}], " ", 
             RowBox[{"(", 
              RowBox[{"rs", "-", "x0", "+", 
               RowBox[{
                SuperscriptBox["HL", "2"], " ", 
                SuperscriptBox["x0", "3"]}]}], ")"}]}]]}]], ",", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
          "}"}]}], "}"}]}], ",", 
      RowBox[{"\<\"gamma^mu (E_A^mu factors)\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         SqrtBox[
          RowBox[{"1", "-", 
           FractionBox["rs", "x0"], "-", 
           RowBox[{
            SuperscriptBox["HL", "2"], " ", 
            SuperscriptBox["x0", "2"]}]}]], ",", "1", ",", "1", ",", "1", ",", 
         FractionBox["1", 
          SqrtBox[
           RowBox[{"1", "-", 
            FractionBox["rs", "x0"], "-", 
            RowBox[{
             SuperscriptBox["HL", "2"], " ", 
             SuperscriptBox["x0", "2"]}]}]]], ",", "1", ",", "1", ",", "1"}], 
        "}"}]}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[23]=",ExpressionUUID->"6b07fd08-aed6-4359-ae91-2d881bdb8d5b"],

Cell["\<\
Hence the Euler-Lagrange equations of dirac16complex in the three \
gravitational fields are, explicitly (A summed over 0..7, T^A = T16A[A]):
PRIMORDIAL:  Cot[6Hx0] T^0 d0 psi + E^(H x4) Sin[6Hx0]^(1/6) (T^1 d1 + T^2 d2 \
+ T^3 d3) psi + T^4 d4 psi + E^(-H x4) Sin[6Hx0]^(1/6) (T^5 d5 + T^6 d6 + T^7 \
d7) psi - 3 H Cot[6Hx0]^2 T^0 psi = (m + lam psibar psi) psi .
MODERN:      Sqrt[f] T^0 d0 psi + (T^1 d1 + T^2 d2 + T^3 d3) psi + f^(-1/2) \
T^4 d4 psi + (T^5 d5 + T^6 d6 + T^7 d7) psi + (f'/(4 Sqrt[f])) T^0 psi = (m + \
lam psibar psi) psi , f = 1 - rs/x0 .
FUTURE:      the same as MODERN with f = 1 - rs/x0 - HL^2 x0^2 .
For configurations depending only on x0 and x4, only the T^0 and T^4 terms \
survive.\
\>", "Text",ExpressionUUID->"10bc6158-2d64-4e59-8982-cb57a8e1fca9"],

Cell["5.1 Mass-sign pairing holds in every gravitational field", "Subsection",ExpressionUUID->"bdd3bd57-90db-420c-b5b7-fe996c566c56"],

Cell["\<\
Two maps send the Lagrangian with mass +m to the Lagrangian with mass -m, in \
each field: (a) the antilinear 'charge conjugation' C: psi -> Gamma psi^* \
(Gamma = T16A[8]); (b) the Pin(4,4) reflection P1: psi(x) -> T16A[1] psi(R1 \
x), R1: x1 -> -x1 (an isometry of all three fields). We verify L_(m,lam)[C \
psi] = L_(-m,lam)[psi] and L_(m,lam)[P1 psi] = L_(-m,lam)[psi] as exact \
identities in the Grassmann algebra.\
\>", "Text",ExpressionUUID->"9abf1702-9e86-4f13-9463-61795453a322"],

Cell["\<\
pairingChecks = <||>;
Do[Module[{sc = spinConnection[fields[c], X], Om, gam, sqrtg, L, ruleC, ruleP},
   Om = sc[\"Omega\"]; gam = sc[\"gam\"]; sqrtg = \
Simplify[Sqrt[Abs[Det[sc[\"g\"]]]], assum[c]];
   L = gScale[sqrtg, gAdd[gScale[1/2, gAdd @@ Table[gBil[psiS, \
sigma16.gam[[mu + 1]], dpsi[mu]], {mu, 0, 7}]], gScale[1/2, gBil[psiS, \
Simplify[sigma16.Sum[gam[[mu]].Om[[mu]], {mu, 8}]], psi]],
      gScale[-1/2, gAdd @@ Table[gBil[dpsiS[mu], sigma16.gam[[mu + 1]], psi], \
{mu, 0, 7}]], gScale[1/2, gBil[psiS, Simplify[sigma16.Sum[Om[[mu]].gam[[mu]], \
{mu, 8}]], psi]], gScale[-m, Sbil], gScale[-lam/2, gMul[Sbil, Sbil]]]];
   ruleC[gen[\"psi\", a_, d_]] := gAdd @@ Table[gScale[Gamma5[[a + 1, b + \
1]], gGen[gen[\"psiS\", b, d]]], {b, 0, 15}];
   ruleC[gen[\"psiS\", a_, d_]] := gAdd @@ Table[gScale[Gamma5[[a + 1, b + \
1]], gGen[gen[\"psi\", b, d]]], {b, 0, 15}];
   ruleP[gen[t_, a_, d_]] := gScale[(-1)^Count[d, 1], gAdd @@ \
Table[gScale[T16A[1][[a + 1, b + 1]], gGen[gen[t, b, d]]], {b, 0, 15}]];
   pairingChecks[c] = <|\"L[Gamma psi^*] == L(m->-m)[psi]\" -> \
gZeroQ[gSimplify[gAdd[gLinSub[L, ruleC], gScale[-1, L /. m -> -m]], assum[c]]],
     \"L[T1 psi(R1x)] == L(m->-m)[psi](R1x)\" -> \
gZeroQ[gSimplify[gAdd[gLinSub[L, ruleP], gScale[-1, L /. m -> -m]], \
assum[c]]]|>], {c, Keys[fields]}];
pairingChecks\
\>", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"aa3233ea-40c7-451e-930f-93ac82b09406"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"primordial\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"L[Gamma psi^*] == L(m->-m)[psi]\"\>", "\[Rule]", "True"}], 
      ",", 
      RowBox[{"\<\"L[T1 psi(R1x)] == L(m->-m)[psi](R1x)\"\>", "\[Rule]", 
       "True"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"modern\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"L[Gamma psi^*] == L(m->-m)[psi]\"\>", "\[Rule]", "True"}], 
      ",", 
      RowBox[{"\<\"L[T1 psi(R1x)] == L(m->-m)[psi](R1x)\"\>", "\[Rule]", 
       "True"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"future\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"L[Gamma psi^*] == L(m->-m)[psi]\"\>", "\[Rule]", "True"}], 
      ",", 
      RowBox[{"\<\"L[T1 psi(R1x)] == L(m->-m)[psi](R1x)\"\>", "\[Rule]", 
       "True"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[24]=",ExpressionUUID->"2fce2a51-ce1f-492d-bdc5-878be72914ab"],

Cell["\<\
Part 6 (appended). DFT-motivated Kohn-Sham approximation: ground and first \
excited states\
\>", "Section",ExpressionUUID->"d5a2a58b-63a0-4d7b-b79b-bdd119a24aab"],

Cell["\<\
6.1 The Kohn-Sham equation of dirac16complex in a static gravitational field\
\>", "Subsection",ExpressionUUID->"65c04807-8887-4182-8a0c-b1563685c3ed"],

Cell["\<\
For a static field with lapse B(x0) = e^4_4 and hidden scale N(x0) = e^0_0, a \
stationary mode psi = Exp[-I eps x4] u(x0) of the field equation, after the \
rescaling u -> (Sqrt|g|/N)^(1/2) u (which removes the spin-connection term) \
and in the tortoise coordinate rho with d rho = (N/B) dx0, obeys the \
Kohn-Sham equation
h_KS chi = eps chi ,  h_KS = alpha p + W(rho) beta ,  p = -I d/d rho ,  alpha \
= -T^4 T^0 ,  beta = -I T^4 ,  W = B (m + lam rho_s) .
The quartic self-coupling is treated in the Kohn-Sham (Hartree, \
scalar-channel) approximation: (lam/2)(psibar psi)^2 -> lam rho_s psibar psi \
- (lam/2) rho_s^2 with rho_s = <psibar psi> computed from the occupied \
Kohn-Sham orbitals (a local, LDA-type density functional). alpha and beta are \
Hermitian anticommuting involutions that commute with K, so h_KS is 8 copies \
(4 with K = +1, 4 with K = -1) of the 2x2 operator [[0, A^T],[A, 0]], A = d/d \
rho + W. Bag boundary conditions u(rho_L) = 0, v(rho_R) = 0 are imposed. Its \
spectrum is EXACTLY symmetric, eps <-> -eps: the unitary T^0 and the \
antiunitary complex conjugation both anticommute with h_KS.\
\>", "Text",ExpressionUUID->"6a6d82c8-2f85-4b62-b7fa-c2b2a905ad48"],

Cell["\<\
<|\"alpha, beta Hermitian involutions, anticommuting\" -> {alphaKS == \
ConjugateTranspose[alphaKS], betaKS == ConjugateTranspose[betaKS], \
alphaKS.alphaKS == ID16, betaKS.betaKS == ID16, alphaKS.betaKS + \
betaKS.alphaKS == 0 ID16},
 \"[K,alpha] = [K,beta] = [K,T^0] = 0\" -> {K.alphaKS == alphaKS.K, K.betaKS \
== betaKS.K, K.T16A[0] == T16A[0].K},
 \"T^0 alpha T^0 = -alpha, T^0 beta T^0 = -beta (unitary pairing)\" -> \
{T16A[0].alphaKS.T16A[0] == -alphaKS, T16A[0].betaKS.T16A[0] == -betaKS},
 \"alpha real, beta imaginary (antiunitary pairing h^* = -h)\" -> \
{Conjugate[alphaKS] == alphaKS, Conjugate[betaKS] == -betaKS},
 \"bag operator T^0 = -I alpha.beta\" -> (T16A[0] == -I alphaKS.betaKS)|>\
\>", "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"90eee8ee-d29e-494c-aae0-fe6a41e30523"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"alpha, beta Hermitian involutions, anticommuting\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"[K,alpha] = [K,beta] = [K,T^0] = 0\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"T^0 alpha T^0 = -alpha, T^0 beta T^0 = -beta (unitary \
pairing)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"alpha real, beta imaginary (antiunitary pairing h^* = \
-h)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"bag operator T^0 = -I alpha.beta\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[25]=",ExpressionUUID->"e0e2f3a8-467b-47e5-aad5-1ea9f98349be"],

Cell["\<\
6.2 Numerical Kohn-Sham solver (staggered grid, exact eps <-> -eps symmetry)\
\>", "Subsection",ExpressionUUID->"12aeaced-459e-4dc0-aa17-9cd4f37505c7"],

Cell["\<\
ksMatrixA[Whalf_List, d_] := Module[{n = Length[Whalf]},
  SparseArray[Join[Table[{j, j} -> 1/d + Whalf[[j]]/2, {j, 1, n}], Table[{j, \
j - 1} -> -1/d + Whalf[[j]]/2, {j, 2, n}]], {n, n}]];
ksSolveW[Wh_List, d_] := Module[{A = Normal[ksMatrixA[Wh, d]], P, S, Q, s, \
ord},
  {P, S, Q} = SingularValueDecomposition[N[A]]; s = Diagonal[S]; ord = \
Ordering[s];
  <|\"s\" -> s[[ord]], \"Q\" -> Q[[All, ord]], \"P\" -> P[[All, ord]], \"d\" \
-> d|>];
ksScalarDensity[sol_, k_] := Module[{q = sol[\"Q\"][[All, k]], p = \
sol[\"P\"][[All, k]], d = sol[\"d\"], qh}, qh = (q + Prepend[Most[q], 0])/2; \
2 qh p/(2 d)];
(* test against the analytic bag spectrum  k Cos[k L] + m Sin[k L] = 0 , eps \
= Sqrt[k^2 + m^2] *)
Module[{sol = ksSolveW[ConstantArray[1., 1600], 5./1600], ks},
 ks = k /. Table[FindRoot[k Cos[5 k] + Sin[5 k] == 0, {k, k0}], {k0, {0.6, \
1.2, 1.9}}];
 <|\"numerical levels\" -> Take[sol[\"s\"], 3], \"analytic levels\" -> \
Sqrt[ks^2 + 1]|>]\
\>", "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"7624afc7-2925-4ac1-8207-3d3b07f78688"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"numerical levels\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "1.1320441573585116`", ",", "1.4796329066859726`", ",", 
      "1.953177230351393`"}], "}"}]}], ",", 
   RowBox[{"\<\"analytic levels\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "1.132111728246529`", ",", "1.4798645192503834`", ",", 
      "1.9536087646358815`"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[26]=",ExpressionUUID->"95cb6ec2-e28b-4973-9305-1de7412b1c2f"],

Cell["\<\
6.3 Self-consistent field, two vacua, ground and first excited states\
\>", "Subsection",ExpressionUUID->"c43046f0-37f0-4fec-881b-67c03f56c573"],

Cell["\<\
Each of the 8 copies contributes to rho_s. Because sigma16 = K.beta, the K = \
-1 copies enter psibar psi with a minus sign. Two natural vacua exist. V1 \
(Spin(4,4)-symmetric vacuum, zeta = +1): both sectors fill their \
negative-field-energy levels; the two condensates ADD, rho_s = 8 rho_copy, \
and a dynamical mass is generated self-consistently (as in the \
Nambu-Jona-Lasinio model; the grid spacing is the ultraviolet cutoff). V2 \
(zero-energy mirror vacuum, zeta = -1): both sectors fill eps < 0; the \
condensates CANCEL, rho_s = 0, W = B m exactly, and the total vacuum energy \
is exactly 0. The first excited state is computed by Delta-SCF: one \
particle-hole pair in the lowest level of one copy, with the field re-solved \
self-consistently.\
\>", "Text",ExpressionUUID->"168387ad-9adf-434a-98aa-2b49ab484bdd"],

Cell["\<\
dftSCF[Bv_List, d_, mm_, lm_, zeta_, excite_ : 0, T_ : 0, mix_ : 0.5, tol_ : \
1.*^-11, maxit_ : 500] :=
 Module[{M = ConstantArray[N[mm], Length[Bv]], sol, dens, w, rhoCopy, rhos, \
Mnew, it = 0, err = 1., s, Eband, Eint},
  While[err > tol && it < maxit, it++;
   sol = ksSolveW[Bv M, d]; s = sol[\"s\"]; dens = Table[ksScalarDensity[sol, \
k], {k, Length[s]}];
   w = If[T == 0, ConstantArray[1., Length[s]], Tanh[s/(2 T)]];
   rhoCopy = -w.dens; rhos = 4 rhoCopy + zeta 4 rhoCopy + Total[excite] 2 \
dens[[1]];
   Mnew = mm + lm rhos; err = Max[Abs[Mnew - M]]; M = (1 - mix) M + mix \
Mnew];
  sol = ksSolveW[Bv M, d]; s = sol[\"s\"];
  Eband = If[T == 0, -4 Total[s] - 4 zeta Total[s] + Total[2 s[[1]] excite],
    4 Total[-s - 2 T Log[1 + Exp[-s/T]]] + zeta 4 Total[-s - 2 T Log[1 + \
Exp[-s/T]]]];
  Eint = -(lm/2) Total[Bv rhos^2] d;
  <|\"M\" -> M, \"s\" -> s, \"iterations\" -> it, \"E\" -> Eband + Eint, \
\"Eband\" -> Eband, \"Eint\" -> Eint|>];
Hn = 1.; rsn = 1.; HLn = 0.1; mn = 1.; lamn = -0.03; dgrid = 0.02;
fFn[x_] := 1 - rsn/x - HLn^2 x^2;
horizonsF = Sort[x /. NSolve[x fFn[x] == 0 && x > 0, x, Reals]];
tortF = Interpolation[Table[{NIntegrate[1/fFn[y], {y, 3., x}], x}, {x, \
Subdivide[horizonsF[[1]] + 0.002, horizonsF[[2]] - 0.002, 4000]}]];
maps = <|\"primordial\" -> {ArcCos[Exp[-6 Hn #]]/(6 Hn) &, 1. &, {0., 4.}},
   \"modern\" -> {rsn (1 + ProductLog[Exp[#/rsn - 1]]) &, Sqrt[1 - rsn/#] &, \
{-4., 6.}},
   \"future\" -> {tortF[#] &, Sqrt[fFn[#]] &, {-3., 3.}}|>;
dftResults = <||>;
Do[Module[{xmap, Bfun, rL, rR, n, d, rv, Bv, v2, v2p, v2m, v2pair, v1, v1x},
   {xmap, Bfun, {rL, rR}} = maps[c]; n = Round[(rR - rL)/dgrid]; d = (rR - \
rL)/n;
   rv = Table[rL + (j - 1/2) d, {j, n}]; Bv = Bfun /@ (xmap /@ rv);
   v2 = dftSCF[Bv, d, mn, lamn, -1]; v2p = dftSCF[Bv, d, mn, lamn, -1, {+1}]; \
v2m = dftSCF[Bv, d, mn, lamn, -1, {-1}]; v2pair = dftSCF[Bv, d, mn, lamn, -1, \
{+1, -1}];
   v1 = dftSCF[Bv, d, mn, lamn, +1]; v1x = dftSCF[Bv, d, mn, lamn, +1, {+1}];
   dftResults[c] = <|\"rho grid\" -> rv, \"B\" -> Bv, \"x0 range\" -> \
MinMax[xmap /@ rv],
     \"V2: max|W/B - m|\" -> Max[Abs[v2[\"M\"] - mn]], \"V2: E_vacuum\" -> \
v2[\"E\"], \"V2: lowest levels\" -> Take[v2[\"s\"], 3],
     \"V2: dE(+ universe pair)\" -> v2p[\"E\"] - v2[\"E\"], \"V2: dE(- \
universe pair)\" -> v2m[\"E\"] - v2[\"E\"], \"V2: dE(both, created \
together)\" -> v2pair[\"E\"] - v2[\"E\"],
     \"V1: M range\" -> MinMax[v1[\"M\"]], \"V1: E0\" -> v1[\"E\"], \"V1: \
E1-E0 (Delta-SCF)\" -> v1x[\"E\"] - v1[\"E\"], \"V1: lowest levels\" -> \
Take[v1[\"s\"], 3],
     \"V1: M profile\" -> v1[\"M\"], \"V1 iterations\" -> \
v1[\"iterations\"]|>], {c, Keys[maps]}];
KeyDrop[#, {\"rho grid\", \"B\", \"V1: M profile\"}] & /@ dftResults\
\>", "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"d580107b-ed31-4882-82fe-5818340bfc40"],

