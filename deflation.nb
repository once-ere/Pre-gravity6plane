Cell["1.2 Exact checks", "Subsection",ExpressionUUID->"5993f91d-2ad5-46b7-b995-00965487a58b"],

Cell["\<\
The T^A are real (entries -1, 0, 1) and satisfy T^A T^B + T^B T^A = 2 eta^AB \
I16; T^0..T^3 are symmetric and T^4..T^7 antisymmetric; Gamma = T^0 T^1 ... \
T^7 = diag(-I8, I8); sigma16 = T^0 T^1 T^2 T^3 = diag(-sigma, sigma); \
(sigma16 T^A)^T = -sigma16 T^A, so the Dirac adjoint psibar = psi^dagger \
sigma16 makes psibar T^A psi a vector and psibar psi a scalar under \
Spin(4,4), generated by S^AB = (1/4)[T^A, T^B].\
\>", "Text",ExpressionUUID->"d36b353e-9920-4e4f-8188-5b8897e557e5"],

Cell["\<\
<|\"T^A real, entries in {-1, 0, 1}\" -> SubsetQ[{-1, 0, 1}, \
Union[Flatten[Table[T16A[A], {A, 0, 7}]]]],
 \"T^A T^B + T^B T^A == 2 eta^AB I16\" -> (And @@ \
Flatten[Table[T16A[A].T16A[B] + T16A[B].T16A[A] == 2 eta4488[[A + 1, B + 1]] \
ID16, {A, 0, 7}, {B, 0, 7}]]),
 \"T^0..T^3 symmetric, T^4..T^7 antisymmetric\" -> ((And @@ \
Table[Transpose[T16A[A]] == T16A[A], {A, 0, 3}]) && (And @@ \
Table[Transpose[T16A[A]] == -T16A[A], {A, 4, 7}])),
 \"Gamma == diag(-I8, I8)\" -> (T16A[8] == ArrayFlatten[{{-ID8, 0}, {0, \
ID8}}]), \"sigma16 == diag(-sigma, sigma)\" -> (sigma16 == \
ArrayFlatten[{{-sigma, 0}, {0, sigma}}]),
 \"(sigma16 T^A)^T == -sigma16 T^A\" -> (And @@ \
Table[Transpose[sigma16.T16A[A]] == -sigma16.T16A[A], {A, 0, 7}]),
 \"[S^AB, T^C] == eta^BC T^A - eta^AC T^B\" -> (And @@ Flatten[Table[SAB[[A + \
1, B + 1]].T16A[C] - T16A[C].SAB[[A + 1, B + 1]] == eta4488[[B + 1, C + 1]] \
T16A[A] - eta4488[[A + 1, C + 1]] T16A[B], {A, 0, 7}, {B, 0, 7}, {C, 0, \
7}]])|>\
\>", "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"87022d19-a4b3-4a75-b9f6-ddba24f3649f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"T^A real, entries in {-1, 0, 1}\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"T^A T^B + T^B T^A == 2 eta^AB I16\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"T^0..T^3 symmetric, T^4..T^7 antisymmetric\"\>", "\[Rule]", 
    "True"}], ",", 
   RowBox[{"\<\"Gamma == diag(-I8, I8)\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"sigma16 == diag(-sigma, sigma)\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"(sigma16 T^A)^T == -sigma16 T^A\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"[S^AB, T^C] == eta^BC T^A - eta^AC T^B\"\>", "\[Rule]", 
    "True"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",ExpressionUUID->"70553d50-0c5d-4cb4-a8c9-98df732753a1"],

Cell["Part 2. A small exact Grassmann-algebra engine", "Section",ExpressionUUID->"d44e478b-a495-44b9-a32a-a693e261f460"],

Cell["\<\
dirac16complex has 16 complex components psi_a (a = 0..15) and their complex \
conjugates psi_a^*; these 32 objects (and their space-time derivatives) are \
anticommuting Grassmann generators: psi_a psi_b = - psi_b psi_a, in \
particular psi_a^2 = 0. An element of the Grassmann algebra is stored as an \
Association  <| {g1,...,gk} -> coefficient |>  with canonically ordered \
distinct generators. Complex conjugation reverses the order of factors, \
(theta zeta)^* = zeta^* theta^* for Grassmann elements theta, zeta, the \
standard convention compatible with Hermitian conjugation of field operators.\
\
\>", "Text",ExpressionUUID->"e8b816ae-96e2-488a-90f2-3c618ed41105"],

Cell["\<\
gClean[assoc_] := Select[DeleteCases[Map[Together, assoc], 0], True &];
gSortSign[list_] := Module[{ord = Ordering[list]}, \
If[Length[DeleteDuplicates[list]] < Length[list], {0, {}}, {Signature[ord], \
list[[ord]]}]];
gFromMono[c_, gens_List] := Module[{s = gSortSign[gens]}, If[s[[1]] == 0 || c \
=== 0, <||>, <|s[[2]] -> s[[1]] c|>]];
gAdd[xs__Association] := gClean[Merge[{xs}, Total]];
gScale[c_, x_Association] := gClean[c # & /@ x];
gMul[x_Association, y_Association] := Module[{res = <||>},
  KeyValueMap[Function[{k1, c1}, KeyValueMap[Function[{k2, c2},
      Module[{s = gSortSign[Join[k1, k2]]}, If[s[[1]] =!= 0, res[s[[2]]] = \
Lookup[res, Key[s[[2]]], 0] + s[[1]] c1 c2]]], y]], x];
  gClean[res]];
gGen[g_] := <|{g} -> 1|>; gNum[c_] := If[c === 0, <||>, <|{} -> c|>];
gDL[g_, x_Association] := gClean[Association @@ KeyValueMap[Function[{k, c},
     With[{pos = FirstPosition[k, g, {0}][[1]]}, If[pos == 0, Nothing, \
Delete[k, pos] -> (-1)^(pos - 1) c]]], x]];   (* left derivative *)
gDR[g_, x_Association] := gClean[Association @@ KeyValueMap[Function[{k, c},
     With[{pos = FirstPosition[k, g, {0}][[1]]}, If[pos == 0, Nothing, \
Delete[k, pos] -> (-1)^(Length[k] - pos) c]]], x]];  (* right derivative *)
gDx[mu_, x_Association, Xs_List] := Module[{res = <||>},   (* total \
derivative d/dx_mu, Leibniz rule, order preserved *)
  KeyValueMap[Function[{k, c}, res = gAdd[res, gFromMono[D[c, Xs[[mu + 1]]], \
k]];
     Do[res = gAdd[res, gFromMono[c, ReplacePart[k, i -> (k[[i]] /. gen[t_, \
a_, d_] :> gen[t, a, Sort[Append[d, mu]]])]]], {i, Length[k]}]], x];
  gClean[res]];
gConjGen[gen[t_, a_, d_]] := gen[If[t === \"psi\", \"psiS\", \"psi\"], a, d];
gConj[x_Association, rule_ : {}] := Module[{res = <||>},
  KeyValueMap[Function[{k, c}, res = gAdd[res, gFromMono[Conjugate[c] /. \
rule, Reverse[gConjGen /@ k]]]], x]; gClean[res]];
psiF[d_ : {}] := Table[gGen[gen[\"psi\", a, d]], {a, 0, 15}];
psiSF[d_ : {}] := Table[gGen[gen[\"psiS\", a, d]], {a, 0, 15}];
gBil[u_List, M_, v_List] := Module[{res = <||>}, Do[If[M[[i, j]] =!= 0, res = \
gAdd[res, gScale[M[[i, j]], gMul[u[[i]], v[[j]]]]]], {i, Length[u]}, {j, \
Length[v]}]; res];
gMatVec[M_, v_List] := Table[Module[{res = <||>}, Do[If[M[[i, j]] =!= 0, res \
= gAdd[res, gScale[M[[i, j]], v[[j]]]]], {j, Length[v]}]; res], {i, \
Length[M]}];
gVecAdd[u_List, v_List] := MapThread[gAdd, {u, v}]; gVecScale[c_, u_List] := \
gScale[c, #] & /@ u;
gZeroQ[x_Association] := Length[gClean[x]] == 0;
gSimplify[x_Association, assum_ : True] := gClean[Simplify[#, assum] & /@ x];
gLinSub[x_Association, rule_] := Module[{res = <||>},
  KeyValueMap[Function[{k, c}, res = gAdd[res, gScale[c, If[k === {}, \
gNum[1], Fold[gMul, rule /@ k]]]]], x]; res];
p1 = gGen[gen[\"psi\", 1, {}]]; p2 = gGen[gen[\"psi\", 2, {}]]; s1 = \
gGen[gen[\"psiS\", 1, {}]];
<|\"psi1 psi2 + psi2 psi1 = 0\" -> gZeroQ[gAdd[gMul[p1, p2], gMul[p2, p1]]], \
\"psi1^2 = 0\" -> gZeroQ[gMul[p1, p1]],
 \"(psi1^* psi1)^* = psi1^* psi1\" -> gZeroQ[gAdd[gConj[gMul[s1, p1]], \
gScale[-1, gMul[s1, p1]]]]|>\
\>", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"d5a1fb90-c521-4539-8674-f87922569d5e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"psi1 psi2 + psi2 psi1 = 0\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"psi1^2 = 0\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"(psi1^* psi1)^* = psi1^* psi1\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]=",ExpressionUUID->"f26df659-3aaa-48bc-ac57-07ea15f8210c"],

Cell["\<\
Part 3. Fields, Krein operator, spin connection and curvature tools\
\>", "Section",ExpressionUUID->"b4009d25-3c16-4177-a7e9-7618146abf51"],

Cell["\<\
psi = psiF[]; psiS = psiSF[]; dpsi[mu_] := psiF[{mu}]; dpsiS[mu_] := \
psiSF[{mu}];
Sbil = gBil[psiS, sigma16, psi];       (* psibar psi , psibar = \
psi^dagger.sigma16 *)
K = -I sigma16.T16A[4]; betaKS = -I T16A[4];
spinConnection[Evec_List, Xs_List] := Module[{e = DiagonalMatrix[Evec], Ei, \
g, gi, Gam, om, n = Length[Xs], Om, gam},
  Ei = Inverse[e]; g = Transpose[e].eta4488.e; gi = Inverse[g];
  Gam = Table[Simplify[(1/2) Sum[gi[[i, l]] (D[g[[l, j]], Xs[[k]]] + D[g[[l, \
k]], Xs[[j]]] - D[g[[j, k]], Xs[[l]]]), {l, n}]], {i, n}, {j, n}, {k, n}];
  om = Table[Simplify[Sum[e[[A, nu]] (D[Ei[[nu, B]], Xs[[mu]]] + Sum[Gam[[nu, \
mu, la]] Ei[[la, B]], {la, n}]), {nu, n}]], {mu, n}, {A, n}, {B, n}];
  Om = Table[Simplify[(1/4) Sum[om[[mu, A, B]] eta4488[[A, A]] T16A[A - \
1].T16A[B - 1], {A, n}, {B, n}]], {mu, n}];
  gam = Table[Sum[Ei[[nu, A]] T16A[A - 1], {A, n}], {nu, n}];
  <|\"Omega\" -> Om, \"Gamma\" -> Gam, \"gam\" -> gam, \"g\" -> g|>];
covConst[sc_] := And @@ Flatten[Table[Simplify[D[sc[\"gam\"][[nu]], X[[mu]]] \
+ Sum[sc[\"Gamma\"][[nu, mu, la]] sc[\"gam\"][[la]], {la, 8}] + \
sc[\"Omega\"][[mu]].sc[\"gam\"][[nu]] - \
sc[\"gam\"][[nu]].sc[\"Omega\"][[mu]]] == 0 ID16, {mu, 8}, {nu, 8}]];

christoffelG[g_, xs_] := Module[{gi = Simplify[Inverse[g]], n = Length[xs], \
i, j, k, l},
  Table[Simplify[(1/2) Sum[gi[[i, l]] (D[g[[l, j]], xs[[k]]] + D[g[[l, k]], \
xs[[j]]] - D[g[[j, k]], xs[[l]]]), {l, n}]], {i, n}, {j, n}, {k, n}]];
riemannG[g_, xs_] := Module[{G = christoffelG[g, xs], n = Length[xs], i, j, \
k, l, q},
  Table[Simplify[D[G[[i, j, l]], xs[[k]]] - D[G[[i, j, k]], xs[[l]]] + \
Sum[G[[i, k, q]] G[[q, j, l]] - G[[i, l, q]] G[[q, j, k]], {q, n}]], {i, n}, \
{j, n}, {k, n}, {l, n}]];
ricciG[g_, xs_] := Module[{R = riemannG[g, xs], n = Length[xs], i, j, l}, \
Table[Simplify[Sum[R[[i, j, i, l]], {i, n}]], {j, n}, {l, n}]];
einsteinG[g_, xs_] := Module[{Ric = ricciG[g, xs], Rs}, Rs = \
Simplify[Tr[Inverse[g].Ric]]; Simplify[Ric - (1/2) Rs g]];
kretschmannG[g_, xs_] := Module[{R = riemannG[g, xs], gi = Inverse[g], n = \
Length[xs], i, j, k, l, a, b, c, e},
  Simplify[Sum[g[[i, a]] R[[a, j, k, l]] Sum[gi[[j, b]] gi[[k, c]] gi[[l, e]] \
R[[i, b, c, e]], {b, n}, {c, n}, {e, n}], {i, n}, {a, n}, {j, n}, {k, n}, {l, \
n}]]];\
\>", "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"c7570a57-ac60-4c1b-9143-0c86f7ff295f"],

Cell["\<\
The Krein operator K = -I sigma16.T^4 splits dirac16complex into two mirror \
sectors psi_+ = P+ psi and psi_- = P- psi, P+- = (I16 +- K)/2. K is Hermitian \
with K^2 = I16 and eigenvalues +1 and -1 (8 each); it commutes with T^0, ..., \
T^4 and anticommutes with T^5, T^6, T^7; sigma16 = K beta with beta = -I T^4. \
Consequently the terms built from the directions x0..x4 have no cross terms \
between the sectors, psibar T^A d_A psi = psi_+^dagger beta T^A d_A psi_+ - \
psi_-^dagger beta T^A d_A psi_- (A = 0..4) and psibar psi = psi_+^dagger beta \
psi_+ - psi_-^dagger beta psi_-: the K = -1 sector enters the Lagrangian with \
the opposite sign. For a mode psi = E^(-I omega x4) u the canonical energy \
density (1/2)(psibar T^4 d4 psi - (d4 psibar) T^4 psi) equals omega \
psi^dagger K psi, so a mode of the K = -1 sector carries the opposite energy \
of the same mode of the K = +1 sector. The energy of a universe is called its \
mass: K = +1 is the +mass sector and K = -1 the -mass sector.\
\>", "Text",ExpressionUUID->"0603365d-25f7-4930-a6eb-ab73df37dad5"],

Cell["\<\
Pp = (ID16 + K)/2; Pm = (ID16 - K)/2;
uv = Array[ur, 16] + I Array[ui, 16]; psiM = E^(-I om x4) uv;
enM = (1/2) (Conjugate[psiM].sigma16.T16A[4].D[psiM, x4] - Conjugate[D[psiM, \
x4]].sigma16.T16A[4].psiM);
<|\"K Hermitian, K^2 == I16\" -> ((ConjugateTranspose[K] == K) && (K.K == \
ID16)), \"eigenvalues of K\" -> Counts[Eigenvalues[K]],
 \"[K, T^A] == 0 (A = 0..4)\" -> (And @@ Table[K.T16A[A] == T16A[A].K, {A, 0, \
4}]), \"{K, T^A} == 0 (A = 5, 6, 7)\" -> (And @@ Table[K.T16A[A] == \
-T16A[A].K, {A, 5, 7}]),
 \"sigma16 == K beta, beta = -I T^4\" -> (sigma16 == K.betaKS),
 \"P+ sigma16 T^A P- == 0, P+ sigma16 T^A P+ == P+ beta T^A P+, P- sigma16 \
T^A P- == -P- beta T^A P- (A = 0..4)\" -> (And @@ \
Flatten[Table[{Pp.sigma16.T16A[A].Pm == 0 ID16, Pp.sigma16.T16A[A].Pp == \
Pp.betaKS.T16A[A].Pp, Pm.sigma16.T16A[A].Pm == -Pm.betaKS.T16A[A].Pm}, {A, 0, \
4}]]),
 \"P+ sigma16 P- == 0, P+ sigma16 P+ == P+ beta P+, P- sigma16 P- == -P- beta \
P-\" -> ((Pp.sigma16.Pm == 0 ID16) && (Pp.sigma16.Pp == Pp.betaKS.Pp) && \
(Pm.sigma16.Pm == -Pm.betaKS.Pm)),
 \"mode energy density (1/2)(psibar T^4 d4 psi - (d4 psibar) T^4 psi) == \
omega psi^dagger K psi\" -> (Simplify[ComplexExpand[enM - om \
Conjugate[psiM].K.psiM]] === 0)|>\
\>", "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"4d673949-d5cd-49c0-8754-cb6f01968ec1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"K Hermitian, K^2 == I16\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"eigenvalues of K\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "\[Rule]", "8"}], ",", 
      RowBox[{"1", "\[Rule]", "8"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"[K, T^A] == 0 (A = 0..4)\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"{K, T^A} == 0 (A = 5, 6, 7)\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"sigma16 == K beta, beta = -I T^4\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"P+ sigma16 T^A P- == 0, P+ sigma16 T^A P+ == P+ beta T^A P+, \
P- sigma16 T^A P- == -P- beta T^A P- (A = 0..4)\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"P+ sigma16 P- == 0, P+ sigma16 P+ == P+ beta P+, P- sigma16 \
P- == -P- beta P-\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"mode energy density (1/2)(psibar T^4 d4 psi - (d4 psibar) T^4 \
psi) == omega psi^dagger K psi\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[6]=",ExpressionUUID->"ad7046a0-4fad-4742-9553-cb5aaecbd273"],

Cell["Part 4. The deflating degrees of freedom x5, x6, x7", "Section",ExpressionUUID->"3f872641-f594-43f9-8d15-6c31f61115b2"],

Cell["\<\
Vielbein e^A_mu = diag(e_0, ..., e_7) with e_0 = Tan[6 H x0], e_1 = e_2 = e_3 \
= E^(-H x4) Sin[6 H x0]^(-1/6), e_4 = 1, e_5 = Sqrt[g55], e_6 = Sqrt[g66], \
e_7 = Sqrt[g77]; metric g_mu nu = eta_AB e^A_mu e^B_nu, so the x5, x6, x7 \
entries are -g55, -g66, -g77. A coordinate interval dx5 has proper size L5 = \
Sqrt[g55] dx5 = Sqrt[b55] E^(-a x4/2) dx5: it shrinks by the factor E^(-1) \
every Delta x4 = 2/a (deflation rate d ln L5/dx4 = -a/2).\
\>", "Text",ExpressionUUID->"12f20af5-4c1b-47f8-bd0e-93f1bb65fd30"],

Cell["\<\
z0 = 6 H x0;
gjj = {b55 Exp[-a x4], b66 Exp[-a x4], b77 Exp[-a x4]};          (* g55, g66, \
g77 *)
eDefl = {Tan[z0], E^(-H x4) Sin[z0]^(-1/6), E^(-H x4) Sin[z0]^(-1/6), E^(-H \
x4) Sin[z0]^(-1/6), 1, Sqrt[b55] E^(-a x4/2), Sqrt[b66] E^(-a x4/2), \
Sqrt[b77] E^(-a x4/2)};   (* e_j = Sqrt[gjj] *)
gDefl = DiagonalMatrix[eDefl^2 Diagonal[eta4488]];
assumD = H > 0 && 0 < x0 < Pi/(12 H) && a > 0 && b55 > 0 && b66 > 0 && b77 > \
0 && Element[X, Reals] && Element[{m, lam}, Reals];
sqrtgD = Simplify[Times @@ eDefl, assumD];        (* all e_A > 0 in the \
domain *)
<|\"e_j^2 == gjj (j = 5,6,7)\" -> (Simplify[eDefl[[6 ;; 8]]^2 - gjj] == {0, \
0, 0}), \"Sqrt|g|^2 == |det g|\" -> (Simplify[sqrtgD^2 - Abs[Det[gDefl]], \
assumD] == 0),
 \"metric diagonal g_00..g_77\" -> Simplify[Diagonal[gDefl], assumD], \
\"x5,x6,x7 entries equal -g55,-g66,-g77\" -> (Simplify[Diagonal[gDefl][[6 ;; \
8]] + gjj, assumD] == {0, 0, 0}),
 \"proper size per unit dx5\" -> Simplify[Sqrt[gjj[[1]]], assumD], \
\"deflation rate d ln L5/dx4\" -> Simplify[D[Log[Sqrt[gjj[[1]]]], x4], assumD],
 \"volume factor of the deflating 3-space\" -> Simplify[Sqrt[Times @@ gjj], \
assumD], \"Sqrt|g|\" -> sqrtgD|>\
\>", "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"598fb1de-796a-4422-a2e5-7806225d520f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"e_j^2 == gjj (j = 5,6,7)\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Sqrt|g|^2 == |det g|\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"metric diagonal g_00..g_77\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Tan", "[", 
        RowBox[{"6", " ", "H", " ", "x0"}], "]"}], "2"], ",", 
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "H", " ", "x4"}]], 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
        RowBox[{"1", "/", "3"}]]], ",", 
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "H", " ", "x4"}]], 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
        RowBox[{"1", "/", "3"}]]], ",", 
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "H", " ", "x4"}]], 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
        RowBox[{"1", "/", "3"}]]], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{
       RowBox[{"-", "b55"}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "x4"}]]}], ",", 
      RowBox[{
       RowBox[{"-", "b66"}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "x4"}]]}], ",", 
      RowBox[{
       RowBox[{"-", "b77"}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "x4"}]]}]}], "}"}]}], ",", 
   RowBox[{"\<\"x5,x6,x7 entries equal -g55,-g66,-g77\"\>", "\[Rule]", 
    "True"}], ",", 
   RowBox[{"\<\"proper size per unit dx5\"\>", "\[Rule]", 
    SqrtBox[
     RowBox[{"b55", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "a"}], " ", "x4"}]]}]]}], ",", 
   RowBox[{"\<\"deflation rate d ln L5/dx4\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox["a", "2"]}]}], ",", 
   RowBox[{"\<\"volume factor of the deflating 3-space\"\>", "\[Rule]", 
    SqrtBox[
     RowBox[{"b55", " ", "b66", " ", "b77", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "3"}], " ", "a", " ", "x4"}]]}]]}], ",", 
   RowBox[{"\<\"Sqrt|g|\"\>", "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["3", "2"]}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "+", 
         RowBox[{"2", " ", "H"}]}], ")"}], " ", "x4"}]], " ", 
     RowBox[{"Sec", "[", 
      RowBox[{"6", " ", "H", " ", "x0"}], "]"}], " ", 
     SqrtBox[
      RowBox[{"b55", " ", "b66", " ", "b77", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"6", " ", "H", " ", "x0"}], "]"}]}]]}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[7]=",ExpressionUUID->"dd02454a-f74a-4774-a25a-7aaf85e07239"],

Cell["Part 5. Curvature of the deflation field", "Section",ExpressionUUID->"e6e70f0d-0fca-4d1d-87a8-380a11efd35a"],

Cell["\<\
Ricci tensor R_jl = R^i_jil, scalar R = g^jl R_jl, Einstein tensor G_mu nu = \
R_mu nu - (1/2) R g_mu nu (the diagonal mixed components G^mu_mu and every \
non-zero off-diagonal Ricci component R_mu nu, mu < nu, are shown), and the \
Kretschmann scalar R_abcd R^abcd, computed with the diagonal-metric formula \
Sum g_aa g^bb g^cc g^dd (R^a_bcd)^2. We check that these invariants do not \
depend on x4 and compute their behaviour at x0 -> 0. The pure deflation field \
(x0..x3 flat and x4 undeformed, ds^2 = dx0^2+dx1^2+dx2^2+dx3^2-dx4^2-g55 \
dx5^2-g66 dx6^2-g77 dx7^2) isolates the effect of the deflating degrees of \
freedom; its curvature invariants are constants.\
\>", "Text",ExpressionUUID->"31b737f6-2c23-4037-9240-cac80fe2e56e"],

Cell["\<\
kretschmannDiag[g_, xs_] := Module[{R = riemannG[g, xs], n = Length[xs], gd = \
Diagonal[g], i, j, k, l},
  Simplify[Sum[gd[[i]]/(gd[[j]] gd[[k]] gd[[l]]) R[[i, j, k, l]]^2, {i, n}, \
{j, n}, {k, n}, {l, n}]]];
RicD = ricciG[gDefl, X]; RsD = Simplify[Tr[Inverse[gDefl].RicD], assumD]; KD \
= kretschmannDiag[gDefl, X];
GmixD = Simplify[Diagonal[Inverse[gDefl].(RicD - (1/2) RsD gDefl)], assumD];
<|\"Ricci scalar\" -> RsD, \"mixed Einstein tensor G^0_0 ... G^7_7\" -> \
GmixD,
 \"non-zero off-diagonal Ricci components {mu, nu} -> R_mu nu (mu < nu)\" -> \
Select[Flatten[Table[If[i < j, {i - 1, j - 1} -> Simplify[RicD[[i, j]], \
assumD], Nothing], {i, 8}, {j, 8}]], #[[2]] =!= 0 &],
 \"G_04 == R_04 (because g_04 = 0)\" -> (Simplify[(RicD - (1/2) RsD \
gDefl)[[1, 5]] - RicD[[1, 5]], assumD] === 0),
 \"Kretschmann scalar R_abcd R^abcd\" -> KD, \"R, G^mu_mu, R_04 and R_abcd \
R^abcd do not depend on x4\" -> FreeQ[{RsD, GmixD, Simplify[RicD[[1, 5]], \
assumD], KD}, x4],
 \"x0^4 R as x0 -> 0\" -> Limit[x0^4 RsD, x0 -> 0, Direction -> \
\"FromAbove\", Assumptions -> H > 0 && a > 0],
 \"x0^8 R_abcd R^abcd as x0 -> 0\" -> Limit[x0^8 KD, x0 -> 0, Direction -> \
\"FromAbove\", Assumptions -> H > 0 && a > 0]|>\
\>", "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"81c465c5-c656-4145-8cce-6e0811671038"],

