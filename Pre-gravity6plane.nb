c2b37b94f486"],

Cell[TextData[{
 StyleBox["The origin of this calculation has its roots in \
\[OpenCurlyDoubleQuote]A Remarkable Representation of the 3+2 de Sitter Group\
\[CloseCurlyDoubleQuote] by P.A.M.Dirac, J.Math.Phys.4,901\[Dash]909 (1963). \
\n\nThe term \[OpenCurlyDoubleQuote]reduced Brauer\[Dash]Weyl generators\
\[CloseCurlyDoubleQuote],  refers to a specific set of irreducible generators \
for certain complex Clifford algebras, particularly in the context of \
mathematical physics and the study of Dirac spinors.\[NonBreakingSpace]These \
generators were introduced by ",
  FontColor->GrayLevel[0]],
 StyleBox["E.A. Lord",
  FontWeight->"Bold"],
 StyleBox[" (E. A. Lord. \[OpenCurlyDoubleQuote]The Dirac spinor in six \
dimensions\[CloseCurlyDoubleQuote]. Mathematical Proceedings of the Cambridge \
Philosophical Society, vol. 64, pp. 765\[Dash]778, 1968) and are described as \
\[OpenCurlyDoubleQuote]reduced\[CloseCurlyDoubleQuote] because they form an \
irreducible representation of the Clifford algebra   ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalC]", 
    RowBox[{"2", " ", "n"}]], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "478dd2a0-84ab-124d-b661-ba7ffbb8898d"],
 StyleBox["  from   ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalC]", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"n", "-", "1"}], ")"}]}]], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "da010d0f-a9e9-db44-a2ff-69303527112c"],
 StyleBox["\[NonBreakingSpace].\n\nHere,  we employ  Lord\[CloseCurlyQuote]s  \
idea of reduced Brauer\[Dash]Weyl generators to extend \
Dirac\[CloseCurlyQuote]s 4\[Times]4 gamma matrices into  this notebook\
\[CloseCurlyQuote]s  real tau8  8\[Times]8 and  tau16   16\[Times]16 \
matrices,\nwhich  are  employed  to write  down the \[OpenCurlyQuote]Dirac \
Equation  for the Pre-Universe\[CloseCurlyQuote]\n[remember, this is before  \
the  Big Bang,  and before  the particles  of  the  standard  model  exist ]\n\
  formulated  in  terms  of a 16-component    ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    RowBox[{"O", 
     RowBox[{"(", 
      RowBox[{"4", ",", "4"}], ")"}]}], "_"], TraditionalForm]],
  ExpressionUUID->"1e57fafb-0977-e542-b613-3cbc9f8c6c35"],
 StyleBox[" spinor \[CapitalPsi]16\n(\[CapitalPsi]16  AKA \[OpenCurlyQuote]",
  FontColor->GrayLevel[0]],
 StyleBox["WAVE FUNCTION OF  the UN-UNIVERSE,\[CloseCurlyQuote]",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox[" which could possibly be named something more pompous).\nThis \
equation is used to  investigate EINSTEIN AND ROSEN\[CloseCurlyQuote]s idea\n\
\n",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  StyleBox[
   GraphicsBox[
    TagBox[RasterBox[CompressedData["
