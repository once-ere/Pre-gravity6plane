Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Tau]A", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Eta]", "AB"], "[", 
       RowBox[{"[", 
        RowBox[{"#", ",", "#"}], "]"}], "]"}], "*", 
      RowBox[{"\[Tau]", "[", 
       RowBox[{"#", "-", "1"}], "]"}]}], "&"}], "/@", 
    RowBox[{"Range", "[", "8", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"mabc", "[", 
       RowBox[{"[", 
        RowBox[{"a1", ",", "b1", ",", "c1"}], "]"}], "]"}], "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox[
            SuperscriptBox["E", "A"], "a"], "[", "hUSE", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"A1", ",", "a1"}], "]"}], "]"}], "*", 
         RowBox[{
          RowBox[{"\[Tau]A", "[", 
           RowBox[{"[", "A1", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"c1", ",", "b1"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"A1", ",", "1", ",", "8"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
