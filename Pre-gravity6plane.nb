Cell["\<\
yZ[#] & /@ Range[0, 15]
sYZvar[[All, 2]] /. {z -> #1, t -> #2};
Table[ToExpression[\"((\" <> ToString[FullForm[%[[j]]]] <> \")&)\"], {j, 1, \
Length[%]}];
ssyZ = Thread[%%% -> %]\
\>", "Text",
