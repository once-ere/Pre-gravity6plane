t)*M^2)/(6*C2*H^2))*(H^2*(c21*c22 + c23*c24)*C2^2 - M^2*(c21*c22 - \
c23*c24))/(2*H*C2*M), yZ5(z, t) = -((H^2*(c21*c22 + c23*c24)*C2^2 + \
M^2*(c21*c22 - c23*c24))*exp((6*(z/6 + t)*H^2*C2^2 - 6*(-z/6 + \
t)*M^2)/(6*C2*H^2)))/(2*H*C2*M), yZ6(z, t) = c23*exp((6*(z/6 + t)*H^2*C2^2 - \
6*(-z/6 + t)*M^2)/(6*C2*H^2))*c24, yZ7(z, t) = c21*exp((6*(z/6 + t)*H^2*C2^2 \
- 6*(-z/6 + t)*M^2)/(6*C2*H^2))*c22}}\>\""}], ";"}]], "Input",
 CellLabel->
