      RowBox[{
       RowBox[{"FullSimplify", "[", 
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{"\[Gamma]", "[", 
            RowBox[{"[", "h", "]"}], "]"}], ".", 
