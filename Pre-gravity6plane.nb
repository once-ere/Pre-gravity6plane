Cell["\<\
FOR  MAPLE : A set is an unordered sequence of distinct expressions enclosed \
in braces {}, representing a set in the mathematical sense.
A list is an ordered sequence of expressions enclosed in square brackets []. \
The ordering of the expressions is the ordering of es.
\
\>", "Text",
 CellChangeTimes->{{3.9754312370190372`*^9, 3.9754312523545628`*^9}, {
  3.976355289041464*^9, 3.976355290486326*^9}},
 FontSize->14,
 FontColor->RGBColor[
  0.98, 0.56, 0.17],ExpressionUUID->"21b53826-6ded-9348-a54e-8688a02297ef"],

Cell["\<\
\[OpenCurlyDoubleQuote]maple-output.py\[CloseCurlyDoubleQuote]:
import textwrap
filename = \"maple-output.txt\"
maple_long _string = \"paste maple string here\"
# Wraps the text and joins with newlines
with open (filename, \"w\") as f :
     f . write (\"\\n\" . join (textwrap . wrap (maple_long _string, width = \
80)))\
\>", "Text",
 CellChangeTimes->{{3.9762705939948616`*^9, 3.9762707453452377`*^9}, {
  3.976270789810835*^9, 3.9762708284335155`*^9}, {3.976270858469015*^9, 
