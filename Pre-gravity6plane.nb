Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Qa", "[", 
    RowBox[{"h_", ",", "p_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"Signature", "[", 
    RowBox[{"{", 
     RowBox[{"h", ",", "p", ",", "q", ",", "4"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Qb", "[", 
    RowBox[{"h_", ",", "p_", ",", "q_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"ID4", "[", 
      RowBox[{"[", 
       RowBox[{"p", ",", "4"}], "]"}], "]"}], "*", 
     RowBox[{"ID4", "[", 
      RowBox[{"[", 
       RowBox[{"q", ",", "h"}], "]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"ID4", "[", 
      RowBox[{"[", 
       RowBox[{"p", ",", "h"}], "]"}], "]"}], "*", 
     RowBox[{"ID4", "[", 
      RowBox[{"[", 
       RowBox[{"q", ",", "4"}], "]"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SelfDualAntiSymmetric", "[", 
    RowBox[{"h_", ",", "p_", ",", "q_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Qa", "[", 
     RowBox[{"h", ",", "p", ",", "q"}], "]"}], " ", "-", 
    RowBox[{"Qb", "[", 
     RowBox[{"h", ",", "p", ",", "q"}], "]"}]}]}], " ", ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AntiSelfDualAntiSymmetric", "[", 
    RowBox[{"h_", ",", "p_", ",", "q_"}], "]"}], ":=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Qa", "[", 
      RowBox[{"h", ",", "p", ",", "q"}], "]"}], " ", "+", " ", 
     RowBox[{"Qb", "[", 
      RowBox[{"h", ",", "p", ",", "q"}], "]"}]}], " ", ")"}]}], 
  ";"}]}], "Input",
