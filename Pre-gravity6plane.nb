Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Helper", " ", "to", " ", "perform", " ", "one", " ", "pass", " ", "of", " ",
     "merging"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"MergeSetsStep", "[", "currentSets_List", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", " ", "=", " ", 
         RowBox[{"Length", "[", "currentSets", "]"}]}], ",", " ", "i", ",", 
        " ", "j", ",", " ", 
        RowBox[{"merged", " ", "=", " ", "currentSets"}]}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "We", " ", "look", " ", "for", " ", "the", " ", "first", " ", "pair", " ", 
        RowBox[{"(", 
         RowBox[{"i", ",", " ", "j"}], ")"}], " ", "that", " ", 
        "intersects"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"Catch", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
          RowBox[{"i", " ", "<=", " ", 
           RowBox[{"Length", "[", "merged", "]"}]}], ",", " ", 
          RowBox[{"i", "++"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", " ", "=", " ", 
              RowBox[{"i", " ", "+", " ", "1"}]}], ",", " ", 
             RowBox[{"j", " ", "<=", " ", 
              RowBox[{"Length", "[", "merged", "]"}]}], ",", " ", 
             RowBox[{"j", "++"}], ",", "\n", "         ", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Intersection", "[", 
                  RowBox[{
                   RowBox[{"merged", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                   RowBox[{"merged", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", "=!=", " ", 
                 
                 RowBox[{"{", "}"}]}], ",", "\n", "            ", 
                RowBox[{"(*", " ", 
                 RowBox[{"Found", " ", 
                  RowBox[{"intersection", ":", " ", 
                   RowBox[{
                   "Merge", " ", "and", " ", "Throw", " ", "to", " ", 
                    RowBox[{"restart", "/", "finish"}], " ", "this", " ", 
                    "step"}]}]}], " ", "*)"}], "\n", "            ", 
                RowBox[{
                 RowBox[{"merged", " ", "=", " ", 
                  RowBox[{"Delete", "[", 
                   RowBox[{"merged", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "i", "}"}], ",", " ", 
                    RowBox[{"{", "j", "}"}]}], "}"}]}], "]"}]}], ";", "\n", 
                 "            ", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"merged", ",", " ", 
                   RowBox[{"Sort", "[", 
                    RowBox[{"Union", "[", 
                    RowBox[{
                    RowBox[{"currentSets", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                    RowBox[{"currentSets", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}]}], "]"}], ";",
                  "\n", "            ", 
                 RowBox[{"Throw", "[", 
                  RowBox[{"Sort", "[", "merged", "]"}], "]"}], ";"}]}], " ", 
               RowBox[{"(*", " ", 
                RowBox[{"Sort", " ", "for", " ", "canonical", " ", "form"}], 
                " ", "*)"}], "\n", "         ", "]"}], ";"}]}], "\n", 
            "      ", "]"}], ";"}]}], "\n", "    ", "]"}], ";", "\n", "    ", 
        
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"If", " ", "no", " ", "intersection", " ", "found"}], ",", 
          " ", 
          RowBox[{"return", " ", "original", " ", "sorted"}]}], " ", "*)"}], 
        "\n", "    ", 
        RowBox[{"Sort", "[", "merged", "]"}]}], "\n", "  ", "]"}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{3.978888533172289*^9},
 Background->RGBColor[1., 0.9974670023651484, 0.],
 CellLabel->
  "In[129]:=",ExpressionUUID->"00ce053e-c223-f641-b2a2-eb16df047aeb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"showCoupledEquations", "[", "items_List", "]"}], " ", ":=", " ", 
   RowBox[{"FixedPoint", "[", 
    RowBox[{"MergeSetsStep", ",", " ", "items"}], "]"}]}], ";"}]], "Input",
 Background->RGBColor[0.95, 0.43, 0.96, 0.33],
 CellLabel->
  "In[130]:=",ExpressionUUID->"06a48ce2-1f36-1947-b06e-7765b0ef3112"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "safeInverse", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"safeInverse", "[", 
    RowBox[{"m_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
       RowBox[{"Dimensions", "[", "m", "]"}]}], ";", "\n", "    ", 
      RowBox[{"Catch", "[", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"a", " ", "!=", " ", "b"}], ",", " ", 
         RowBox[{"Throw", "[", 
          RowBox[{"Return", "[", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"##", "&"}], "[", "]"}]}], "]"}], "]"}], ";", "\n", "   ", 
      RowBox[{"Catch", "[", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Det", "[", "m", "]"}], " ", "==", " ", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"Throw", "[", 
           RowBox[{"Return", "[", "\"\<Error: Singular Matrix\>\"", "]"}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{"##", "&"}], "[", "]"}]}], "]"}], "]"}], ";", "\n", "   ", 
      RowBox[{"Return", "[", " ", 
       RowBox[{"Inverse", "[", "m", "]"}], "]"}], ";"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.980334206576359*^9, 3.9803342114346867`*^9}, {
  3.9803343690658703`*^9, 3.9803344865101*^9}, {3.980353469994966*^9, 
  3.98035347350432*^9}},
 Background->RGBColor[0, 0.74, 0.74, 0.33],
 CellLabel->
  "In[131]:=",ExpressionUUID->"57780bb1-2eab-451a-bf56-b46105e5c211"],

Cell[BoxData[
 RowBox[{
  RowBox[{"blockPartition", "[", "mat_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{
      "blocks", ",", "block11", ",", "block12", ",", "block21", ",", 
       "block22", ","}], "*)"}], "ret", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"blocks", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{"mat", ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "8"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"block11", "=", 
        RowBox[{"blocks", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], " ", ";"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"Top", "-", 
       RowBox[{"left", " ", "block"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"block12", "=", 
        RowBox[{"blocks", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}], " ", ";"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"Top", "-", 
       RowBox[{"right", " ", "block"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"block21", "=", 
        RowBox[{"blocks", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}]}], " ", ";"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"Bottom", "-", 
       RowBox[{"left", " ", "block"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"block22", "=", 
        RowBox[{"blocks", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}]}], " ", ";"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"Bottom", "-", 
       RowBox[{"right", " ", "block"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ret", "=", 
      RowBox[{
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}]}], "}"}], "]"}], 
       " ", "===", " ", "mat"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"ret", ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
