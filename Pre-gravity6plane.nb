Cell[BoxData[
 RowBox[{
  RowBox[{"determineIF8AntiSymmetric", "[", "m_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "tt", ",", "sum", ",", "res", ",", "r"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"m", ".", 
         RowBox[{"\[Tau]", "[", "#", "]"}]}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "7"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tt", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", "#", "]"}], "&"}], "/@", "t"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "+", 
          RowBox[{"tt", "[", 
           RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "t", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", "#", "]"}], "]"}], "&"}], "/@", "sum"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], ">", "1"}], ",", 
         RowBox[{"Return", "[", "False", "]"}]}], "]"}], "&"}], "/@", "res"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Flatten", "[", "res", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"r", "==", 
       RowBox[{"{", "0", "}"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9645113891467524`*^9, 3.964511814059523*^9}, {
