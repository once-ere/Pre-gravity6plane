 RowBox[{"{", 
  RowBox[{"\<\"YZ0[z, t] -> ((C1^2*c11*c12*H^2 - C1^2*c13*c14*H^2 - \
c11*c12*M^2 - c13*c14*M^2)*Inactive[Exp][-((M^2*(t - z/6))/(C1*H^2)) + C1*(t \
+ z/6)])/(2*C1*H*M)\"\>", 
   ",", "\<\"YZ1[z, t] -> -1/2*((C1^2*c11*c12*H^2 - C1^2*c13*c14*H^2 + \
