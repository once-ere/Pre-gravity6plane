Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "resolution", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"resolution", "[", "v_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"EAa", ",", "EaA", ",", "FaA", ",", "id", ",", "u"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "v", "]"}], "==", "8"}], ",", 
       RowBox[{
        RowBox[{"##", "&"}], "[", "]"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<ERROR Length[v] \>\"", ",", " ", 
          RowBox[{"Length", "[", "v", "]"}]}], "]"}], ";", 
        RowBox[{"Return", "[", 
         RowBox[{"Length", "[", "v", "]"}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"u", "=", 
      RowBox[{
       FractionBox["v", 
        SqrtBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "v", "]"}], ".", "\[Sigma]", ".", "v"}], 
          "]"}]]], "//", "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"EAa", "=", 
      TagBox[
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"u", ".", "\[Sigma]", ".", 
          RowBox[{
           OverscriptBox["\[Tau]", "_"], "[", "A1", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"A1", ",", "0", ",", "7"}], "}"}]}], "]"}],
       CheckAbort[#, 
        Defer[#]]& ]}], ";", 
     StyleBox[
      GraphicsBox[
       TagBox[RasterBox[CompressedData["
