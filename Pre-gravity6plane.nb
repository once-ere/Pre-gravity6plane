Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"processRawSets", "[", "rawSets_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s1", ",", "s2", ",", "J", ",", "ret", ",", 
       RowBox[{"L", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "rawSets", "]"}], "]"}]}], ",", 
       RowBox[{"r", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "L", "]"}], ">", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"s1", "=", 
          RowBox[{"Union", "[", 
           RowBox[{"rawSets", "[", 
            RowBox[{"[", 
             RowBox[{"L", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"L", "=", 
          RowBox[{"Drop", "[", 
           RowBox[{"L", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"J", "=", 
          RowBox[{"L", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{"J", "<=", "16"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"L", ",", "J"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"s2", "=", 
                RowBox[{"Union", "[", 
                 RowBox[{"rawSets", "[", 
                  RowBox[{"[", "J", "]"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Intersection", "[", 
                   RowBox[{"s1", ",", "s2"}], "]"}], "!=", 
                  RowBox[{"{", "}"}]}], ",", 
