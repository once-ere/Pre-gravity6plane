Cell[BoxData[
 RowBox[{"gridSplitOctonion", "=", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"Reap", "[", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"A1", "=", "1"}], ",", 
             RowBox[{"A1", "<", "9"}], ",", 
             RowBox[{"A1", "++"}], ",", 
             RowBox[{"Sow", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"EA", "[", 
                  RowBox[{"[", "A1", "]"}], "]"}], ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"Sum", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"mABC", "[", 
                    RowBox[{"[", 
                    RowBox[{"A1", ",", "B1", ",", "C1"}], "]"}], "]"}], "*", 
                    RowBox[{"EA", "[", 
