Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"U", ",", 
     RowBox[{"u", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"U", "[", "#", "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", "8", "]"}]}]}], ",", 
     RowBox[{"fx", "=", 
      RowBox[{
       SubsuperscriptBox["F", "A", "a"], ".", "X"}]}], ",", "eq", ",", "sx", ",",
      "su", ",", "ret"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eq", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"Thread", "[", 
       RowBox[{"u", "==", "fx"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"sx", "=", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{"eq", ",", "X"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"su", "=", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{"eq", ",", "u"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ret", "=", 
     RowBox[{"{", 
      RowBox[{"sx", ",", "su"}], "}"}]}], ";", "\[IndentingNewLine]", 
    "ret"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.974876269535981*^9, 3.974876269570356*^9}, {
