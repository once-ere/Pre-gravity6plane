Cell[BoxData[
 RowBox[{
  RowBox[{
  "maplestringEQ1", 
   "=", "\"\<{{yZ0(z, t) = exp((6*(z/6 + t)*H^2*C1^2 - 6*(-z/6 + \
t)*M^2)/(6*C1*H^2))*(H^2*(c11*c12 - c13*c14)*C1^2 - M^2*(c11*c12 + \
c13*c14))/(2*H*C1*M), yZ1(z, t) = -((H^2*(c11*c12 - c13*c14)*C1^2 + \
M^2*(c11*c12 + c13*c14))*exp((6*(z/6 + t)*H^2*C1^2 - 6*(-z/6 + \
t)*M^2)/(6*C1*H^2)))/(2*H*C1*M), yZ2(z, t) = c13*exp((6*(z/6 + t)*H^2*C1^2 - \
6*(-z/6 + t)*M^2)/(6*C1*H^2))*c14, yZ3(z, t) = c11*exp((6*(z/6 + t)*H^2*C1^2 \
- 6*(-z/6 + t)*M^2)/(6*C1*H^2))*c12}}\>\""}], ";"}]], "Input",
 CellLabel->
  "In[714]:=",ExpressionUUID->"817a3e38-ed1e-4841-8807-7139293d1b36"],

